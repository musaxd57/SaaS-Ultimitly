+/**
+ * Y5 (Codex 10-07, HAZIR DAL): metindeki İLK arıza cihazının KANONİK adı (`BREAKDOWN_DEVICES` envanteri, çekimli biçim dahil; ünsüz
+ * yumuşaması kökü sert biçime döner: "musluğ" → "musluk", "kilid" → "kilit"). Yalnız GÖREV KONUSU için — sınıflandırma kararına girmez.
+ */
+export function breakdownDeviceOf(text: string): string | null {
+  for (const tok of text.split(/[^\p{L}\p{N}]+/u)) {
+    if (tok === "") continue;
+    const hit = BREAKDOWN_DEVICES.find((d) => matchesInflectedWord(tok, [d]));
+    if (!hit) continue;
+    const hard = hit.replace(/ğ$/u, "k").replace(/d$/u, "t").replace(/b$/u, "p").replace(/g$/u, "k");
+    return hard !== hit && BREAKDOWN_DEVICES.includes(hard) ? hard : hit;
+  }
+  return null;
+}
