diff --git a/src/lib/answer-reuse/shadow-hook.ts b/src/lib/answer-reuse/shadow-hook.ts
new file mode 100644
index 00000000..c767c400
--- /dev/null
+++ b/src/lib/answer-reuse/shadow-hook.ts
@@ -0,0 +1,80 @@
+import "server-only";
+
+// ---------------------------------------------------------------------------
+// Gönderilen oto-yanıttan sonra doğrulanmış cevap tekrarının GÖLGE ölçümü (migration 85, `AI_ANSWER_REUSE_SHADOW_ENABLED`). Misafire giden
+// metne, kapılara, bildirimlere DOKUNMAZ — yalnız `VerifiedAnswer` tablosuna yazar. Kullanılan parça = doğrulanmış, beyanda "cevaplandı",
+// ve GERÇEKTEN gönderilen metinde duran parça (okuyucu / "bilgim yok" ayıklaması sonrası). Kaynak kimliği istem sırası ("kb:3") değil
+// kalemin kalıcı kimliği.
+// ---------------------------------------------------------------------------
+
+import type { PrismaClient } from "@prisma/client";
+import { cosineOfUnit, embedTexts } from "@/lib/ai/embeddings/provider";
+import { kbLine } from "@/lib/ai/retrieval/kb-line";
+import type { ReplyItemsInput } from "@/lib/conversation-items/reply-block";
+import type { FingerprintItem } from "./core";
+import { answerReuseShadowEnabled, observeVerifiedParts, type ObserveResult, type ObservedPart } from "./store";
+
+export interface ShadowHookInput {
+  organizationId: string;
+  propertyId: string;
+  /** Teyidin geldiği konuşma (yalnız iz özeti saklanır). */
+  conversationId: string;
+  verifiedParts: readonly { ref: string; text: string; evidence: string; source: string }[] | undefined;
+  answeredRefs: readonly string[] | null;
+  replyItems: ReplyItemsInput | undefined;
+  /** İstemdeki bilgi tabanı kalemleri, istem SIRASIYLA ("kb:N" → N-1). Çalışma anında `id` taşır. */
+  kbForModel: readonly unknown[];
+  /** Dairenin bugünkü görünür (onaylı + etkin) kalemleri — parmak izi + yeniden doğrulama. */
+  kbVisible: readonly { id: string; updatedAt: Date; category: string; title: string; content: string }[];
+  property: { checkInTime: string; checkOutTime: string; updatedAt?: Date | null };
+  sentText: string;
+  language: string;
+  guestNames: readonly (string | null | undefined)[];
+  now: Date;
+  /** Testte enjekte edilir; yoksa gömme (bellek önbellekli, 2 sn tavan, sessiz). */
+  similarity?: (a: string, b: string) => Promise<number | null>;
+}
+
+async function embeddingSimilarity(a: string, b: string): Promise<number | null> {
+  const v = await embedTexts([a, b], { deadlineMs: 2_000, quiet: true });
+  return v ? cosineOfUnit(v[0], v[1]) : null;
+}
+
+/** Mülk bilgisinin parça kaynağındaki biçimi (`prompts.ts` `propertyFacts` giriş / çıkış satırları). */
+export function propertySourceText(p: { checkInTime: string; checkOutTime: string }): string {
+  return `Check-in saati: ${p.checkInTime}\nCheck-out saati: ${p.checkOutTime}`;
+}
+
+export async function observeAnswerReuseAfterSend(db: PrismaClient, input: ShadowHookInput): Promise<ObserveResult | null> {
+  if (!answerReuseShadowEnabled() || !input.replyItems?.parts || !input.verifiedParts?.length || !input.answeredRefs) return null;
+  const refs = new Set(input.answeredRefs);
+  const parts: ObservedPart[] = [];
+  for (const v of input.verifiedParts) {
+    if (!refs.has(v.ref) || !input.sentText.includes(v.text)) continue;
+    const item = input.replyItems.answerable.find((a) => a.ref === v.ref);
+    if (!item?.hint) continue;
+    let sourceRef: string | null = null;
+    if (v.source === "property") sourceRef = "property";
+    else if (/^kb:\d+$/.test(v.source)) {
+      const row = input.kbForModel[Number(v.source.slice(3)) - 1] as { id?: unknown } | undefined;
+      if (row && typeof row.id === "string") sourceRef = `kb:${row.id}`;
+    }
+    if (!sourceRef) continue;
+    parts.push({ need: { kind: item.kind, query: item.hint, language: input.language }, partText: v.text, evidence: v.evidence, sourceRef });
+  }
+  if (parts.length === 0) return null;
+  const sources: FingerprintItem[] = [
+    ...input.kbVisible.map((k) => ({ id: `kb:${k.id}`, updatedAt: k.updatedAt, text: kbLine(k) })),
+    { id: "property", updatedAt: input.property.updatedAt ?? new Date(0), text: propertySourceText(input.property) },
+  ];
+  return observeVerifiedParts(db, {
+    organizationId: input.organizationId,
+    propertyId: input.propertyId,
+    conversationId: input.conversationId,
+    parts,
+    sources,
+    guestNames: input.guestNames,
+    now: input.now,
+    similarity: input.similarity ?? embeddingSimilarity,
+  });
+}
diff --git a/src/lib/answer-reuse/store.ts b/src/lib/answer-reuse/store.ts
new file mode 100644
index 00000000..4136be60
--- /dev/null
+++ b/src/lib/answer-reuse/store.ts
@@ -0,0 +1,192 @@
+import "server-only";
+
+// ---------------------------------------------------------------------------
+// DOĞRULANMIŞ CEVAP TEKRARI — GÖLGE KİP deposu (migration 85; tasarım docs/TASARIM-2026-10-23-dogrulanmis-cevap-tekrari.md §4).
+//
+// Misafire HİÇBİR ŞEY bu dosyadan gitmez. Taze, doğrulanmış ve GERÇEKTEN gönderilmiş her parçadan sonra:
+//  1. ölçüm — aynı daire + aynı tür + aynı dil kayıtlarında bu ihtiyaca KULLANILABİLİR bir kayıt var mıydı (kapı + benzerlik + bugünkü
+//     kalemle yeniden doğrulama)? Varsa "isabet"; kayıttaki cevap bu turun taze cevabıyla aynı bilgiyi vermiyorsa "uyuşmazlık" (hedef 0).
+//  2. kayıt — aynı ihtiyacın kaydı varsa: aynı bilgi + aynı kalem izi + BAŞKA konuşma → teyit +1 ve kayıtlı metin iki cevabın ortak
+//     içeriğine daralır (tek misafirin eklediği cümle kalıcılaşmaz — Opus güvenlik 10-23 F7); aynı konuşmanın tekrarı sayılmaz; değilse
+//     kayıt TAZE cevaba sıfırlanır (teyit 1). Yoksa yeni kayıt (teyit 1).
+// Anahtar: `AI_ANSWER_REUSE_SHADOW_ENABLED` (yalnız "1"). Hata ana akışı durdurmaz (çağıran yakalar).
+// ---------------------------------------------------------------------------
+
+import type { Prisma, PrismaClient } from "@prisma/client";
+import { sanitizedReuseQuery } from "@/lib/conversation-items/topic-label";
+import {
+  REUSE_MAX_AGE_DAYS,
+  REUSE_MIN_SIMILARITY,
+  confirmAnswer,
+  conversationKey,
+  entryEligible,
+  relatedFingerprint,
+  revalidateEntry,
+  reuseGate,
+  type FingerprintItem,
+  type ReuseNeed,
+} from "./core";
+
+type Db = PrismaClient | Prisma.TransactionClient;
+
+export function answerReuseShadowEnabled(): boolean {
+  return process.env.AI_ANSWER_REUSE_SHADOW_ENABLED === "1";
+}
+
+/** Kayıtlar bu kadar gün dokunulmadan kalırsa silinir (kalıcı bir misafir izi tutulmaz; içerik zaten 30 günde geçersiz). */
+export const REUSE_PURGE_DAYS = 90;
+
+export interface ObservedPart {
+  need: ReuseNeed;
+  partText: string;
+  evidence: string;
+  /** "kb:<kalem kimliği>" | "property". */
+  sourceRef: string;
+}
+
+/** Kayıtta tutulan konuşma izi sayısı tavanı (kararlılık eşiğinin üstü yeter). */
+export const REUSE_MAX_CONVERSATION_KEYS = 10;
+
+export interface ObserveInput {
+  organizationId: string;
+  propertyId: string;
+  /** Bu turun konuşması — aynı konuşmanın ikinci teyidi sayılmaz (tek misafir kendi cevabını "kararlı" yapamaz). */
+  conversationId: string;
+  parts: readonly ObservedPart[];
+  /** Dairenin bugünkü onaylı + etkin kalemleri ve mülk alanları (parmak izi + yeniden doğrulama). `id` = sourceRef biçimi. */
+  sources: readonly FingerprintItem[];
+  guestNames: readonly (string | null | undefined)[];
+  now: Date;
+  /** İki Türkçe sorgunun benzerliği (gömme; ulaşılamazsa `null` → yalnız birebir aynı sorgu eşleşir). */
+  similarity: (a: string, b: string) => Promise<number | null>;
+}
+
+export interface ObserveResult {
+  hits: number;
+  mismatches: number;
+  confirmed: number;
+  reset: number;
+  created: number;
+  skipped: number;
+  /** Aynı konuşmadan gelen ikinci teyit (sayılmadı). */
+  sameConversation: number;
+}
+
+async function similar(input: ObserveInput, a: string, b: string): Promise<boolean> {
+  if (a === b) return true;
+  const s = await input.similarity(a, b).catch(() => null);
+  return s !== null && s >= REUSE_MIN_SIMILARITY;
+}
+
+/** Gölge ölçüm + kayıt (bkz. dosya başı). Yalnız mülke ait kayıtlara dokunur (org + mülk kapsamı her sorguda). */
+export async function observeVerifiedParts(db: Db, input: ObserveInput): Promise<ObserveResult> {
+  const out: ObserveResult = { hits: 0, mismatches: 0, confirmed: 0, reset: 0, created: 0, skipped: 0, sameConversation: 0 };
+  const convKey = conversationKey(input.conversationId);
+  const scope = { organizationId: input.organizationId, propertyId: input.propertyId };
+  await db.verifiedAnswer
+    .deleteMany({ where: { ...scope, updatedAt: { lt: new Date(input.now.getTime() - REUSE_PURGE_DAYS * 86_400_000) } } })
+    .catch(() => {});
+  const sourceText = (ref: string) => input.sources.find((s) => s.id === ref)?.text ?? null;
+  for (const p of input.parts) {
+    const query = sanitizedReuseQuery(p.need.query, input.guestNames);
+    // Alıntı da taranır: istemdeki kalem yer tutucusu doldurulmuş olabilir ("Hoş geldiniz {misafir}") → misafirin adı kayda girmez.
+    if (!query || entryEligible(p.need, `${p.partText}\n${p.evidence}`, input.guestNames) !== "ok") {
+      out.skipped += 1;
+      continue;
+    }
+    const need: ReuseNeed = { ...p.need, query };
+    const fingerprint = relatedFingerprint(input.sources, query);
+    const rows = await db.verifiedAnswer.findMany({
+      where: { ...scope, kind: need.kind, language: need.language, disabledAt: null },
+      orderBy: { lastConfirmedAt: "desc" },
+      take: 50,
+    });
+    // Aynı ihtiyacın kaydı: kapı (soru + kayıtlı cevap) + benzerlik.
+    let match: (typeof rows)[number] | null = null;
+    for (const r of rows) {
+      const cached: ReuseNeed = { kind: r.kind, query: r.query, language: r.language };
+      if (reuseGate(cached, need, r.partText) !== "ok") continue;
+      if (!(await similar(input, r.query, query))) continue;
+      match = r;
+      break;
+    }
+    if (match) {
+      // ① Ölçüm: kayıt bu ihtiyaca BUGÜN kullanılabilir miydi?
+      const usable = revalidateEntry(
+        {
+          need: { kind: match.kind, query: match.query, language: match.language },
+          partText: match.partText,
+          evidence: match.evidence,
+          sourceId: match.sourceRef,
+          fingerprint: match.fingerprint,
+          confirmations: match.confirmations,
+          createdAt: match.createdAt,
+        },
+        { sourceText: sourceText(match.sourceRef), otherSources: input.sources.filter((s) => s.id !== match!.sourceRef).map((s) => s.text), fingerprint, now: input.now },
+        need,
+      );
+      const verdict = confirmAnswer(match.partText, p.partText);
+      const agrees = verdict.same;
+      if (usable.ok) {
+        if (agrees) out.hits += 1;
+        else out.mismatches += 1;
+      }
+      // ② Kayıt: aynı bilgi + aynı iz + süresi dolmamış + BAŞKA konuşma → teyit (metin ortak içeriğe daralır); aynı konuşmanın tekrarı
+      // sayılmaz; değilse taze cevaba sıfırla.
+      const fresh = input.now.getTime() - match.createdAt.getTime() <= REUSE_MAX_AGE_DAYS * 86_400_000;
+      if (verdict.same && match.fingerprint === fingerprint && fresh) {
+        if (match.conversationKeys.includes(convKey)) {
+          out.sameConversation += 1;
+          continue;
+        }
+        await db.verifiedAnswer.updateMany({
+          where: { id: match.id, ...scope },
+          data: {
+            confirmations: { increment: 1 },
+            partText: verdict.text,
+            ...(verdict.text === p.partText ? { evidence: p.evidence, sourceRef: p.sourceRef } : {}),
+            conversationKeys: [...match.conversationKeys, convKey].slice(-REUSE_MAX_CONVERSATION_KEYS),
+            lastConfirmedAt: input.now,
+            ...(usable.ok ? { shadowHits: { increment: 1 }, lastHitAt: input.now } : {}),
+          },
+        });
+        out.confirmed += 1;
+      } else {
+        await db.verifiedAnswer.updateMany({
+          where: { id: match.id, ...scope },
+          data: {
+            query,
+            partText: p.partText,
+            evidence: p.evidence,
+            sourceRef: p.sourceRef,
+            fingerprint,
+            confirmations: 1,
+            conversationKeys: [convKey],
+            createdAt: input.now,
+            lastConfirmedAt: input.now,
+            ...(usable.ok && !agrees ? { shadowMismatches: { increment: 1 }, lastHitAt: input.now } : {}),
+          },
+        });
+        out.reset += 1;
+      }
+      continue;
+    }
+    await db.verifiedAnswer.create({
+      data: {
+        ...scope,
+        kind: need.kind,
+        language: need.language,
+        query,
+        partText: p.partText,
+        evidence: p.evidence,
+        sourceRef: p.sourceRef,
+        fingerprint,
+        conversationKeys: [convKey],
+        lastConfirmedAt: input.now,
+        createdAt: input.now,
+      },
+    });
+    out.created += 1;
+  }
+  return out;
+}
