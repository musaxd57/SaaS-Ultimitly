+/** Test benzerliği: aynı konu sözcüğünü taşıyan sorgular yakın. */
+const sim = async (a: string, b: string) => (a.split(" ")[0] === b.split(" ")[0] ? 0.9 : 0.1);
+const part = (text = "Çıkış saati 11:00.", query = "çıkış saati checkout") => ({
