+  // 🚨 U42 ödeme tarafı (Codex 10-07, HAZIR DAL): yazma kuruluş satırına PAYLAŞIMLI kilitle (FOR SHARE) tek işlemde. Hesap silme işlemi
+  // aynı satırı FOR UPDATE ile kilitler (tur 2): ya bu yazma önce biter ve silme faturalı aboneliği GÖRÜP 409 der, ya silme önce biter
+  // ve burada kuruluş YOKTUR → "bağlanamayan ödeme" alarmı. Eskiden var olan satırın güncellemesi silmeyle yarışınca 0 satır dönüyor
+  // ve "bayat olay" sanılıp ALARMSIZ düşüyordu (ödeme alınmış olabilir).
+  const outcome = await prisma.$transaction(async (tx) => {
+    const locked = await tx.$queryRaw<{ id: string }[]>`SELECT "id" FROM "Organization" WHERE "id" = ${organizationId} FOR SHARE`;
+    if (locked.length === 0) return "org_gone" as const;
+    if (existing) {
+      const resU = await tx.subscription.updateMany({ where: guardedWhere, data: updateData });
+      return resU.count === 1 ? ("applied" as const) : ("stale" as const); // count 0 → daha taze olay zaten yazılmış
     }
-    throw err;
+    // İlk olay: eşzamanlı ikinci teslim satırı arada yazdıysa (organizationId tekil) çakışma işlemi DÜŞÜRMEZ (`skipDuplicates`) →
+    // korumalı güncellemeye düşülür; sıralama koşulu hangisinin kalacağına karar verir.
+    const created = await tx.subscription.createMany({
+      data: [
+        {
+          organizationId,
+          planCode: planCode ?? "free",
+          status,
+          provider: "paddle",
+          providerRef,
+          currentPeriodEnd,
+          cancelAtPeriodEnd,
+          pastDueSince,
+          lastEventAt: occurredAt,
+          customerId,
+        },
+      ],
+      skipDuplicates: true,
+    });
+    if (created.count === 1) return "applied" as const;
+    const resF = await tx.subscription.updateMany({ where: guardedWhere, data: updateData });
+    return resF.count === 1 ? ("applied" as const) : ("stale" as const);
+  });
+  if (outcome === "org_gone") {
+    if (paying) await alertUnlinkedPayment("subscription", data, "işletme silindi");
+    return;
   }
+  if (outcome === "applied") await settlePending();
 }
 
