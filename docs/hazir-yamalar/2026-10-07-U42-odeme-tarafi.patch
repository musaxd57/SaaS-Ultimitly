+import { describe, it, expect, beforeEach, afterEach, vi } from "vitest";
+import { NextRequest } from "next/server";
+import { createHmac } from "node:crypto";
+
+// ---------------------------------------------------------------------------
+// U42 ÖDEME TARAFI (Codex 10-07, HAZIR DAL — Sabah Kararları 66) — gerçek PostgreSQL.
+// Webhook kuruluşu denetledikten SONRA, abonelik satırını yazmadan ÖNCE hesap silinirse (abonelik kademeli silinir) eski kodun
+// güncellemesi 0 satır dönüyor ve olay "bayat" sayılıp ALARMSIZ düşüyordu — ödeme alınmış olabilir. Doğru: yazma kuruluş satırına
+// paylaşımlı kilitle tek işlemde; kuruluş yoksa "bağlanamayan ödeme" alarmı. Prisma temsilcisine casus → AYRI dosya, dosya düzeyinde.
+// ---------------------------------------------------------------------------
+
+const { reportErrorMock } = vi.hoisted(() => ({ reportErrorMock: vi.fn() }));
+vi.mock("@/lib/report-error", async (orig) => {
+  const actual = await orig<typeof import("@/lib/report-error")>();
+  return { ...actual, reportError: reportErrorMock };
+});
+
+import { POST } from "@/app/api/webhooks/paddle/route";
+import { prisma, resetDb } from "../helpers/db";
+
+const SECRET = "test-webhook-hmac-key-not-a-real-secret";
+const CONTEXT = "paddle-webhook-unlinked-payment";
+
+let interleave: (() => Promise<void>) | null = null;
+const realFindUnique = prisma.subscription.findUnique.bind(prisma.subscription);
+vi.spyOn(prisma.subscription, "findUnique").mockImplementation((async (args: Parameters<typeof realFindUnique>[0]) => {
+  const out = await realFindUnique(args);
+  const hook = interleave;
+  interleave = null;
+  if (hook) await hook();
+  return out;
+}) as never);
+
+function sign(body: string): string {
+  const ts = Math.floor(Date.now() / 1000);
+  return `ts=${ts};h1=${createHmac("sha256", SECRET).update(`${ts}:${body}`, "utf8").digest("hex")}`;
+}
+const post = (event: Record<string, unknown>) => {
+  const body = JSON.stringify(event);
+  return POST(
+    new NextRequest("http://localhost/api/webhooks/paddle", {
+      method: "POST",
+      headers: { "content-type": "application/json", "paddle-signature": sign(body) },
+      body,
+    }),
+  );
+};
+const alarms = () => reportErrorMock.mock.calls.filter(([context]) => context === CONTEXT);
+const renewal = (eventId: string) => ({
+  event_id: eventId,
+  event_type: "subscription.updated",
+  occurred_at: new Date().toISOString(),
+  data: { id: "sub_live", status: "active", customer_id: "ctm_1", items: [{ price: { id: "pri_pro" } }] },
+});
+
+describe("U42 ödeme tarafı — kuruluş arada silinirse olay alarmsız düşmez", () => {
+  let orgId = "";
+  beforeEach(async () => {
+    await resetDb();
+    vi.clearAllMocks();
+    interleave = null;
+    reportErrorMock.mockResolvedValue({ notified: true, throttled: false, configured: true });
+    vi.stubEnv("PADDLE_WEBHOOK_SECRET", SECRET);
+    vi.stubEnv("PADDLE_PRICE_PRO", "pri_pro");
+    orgId = (await prisma.organization.create({ data: { name: "Org" } })).id;
+    await prisma.subscription.create({
+      data: { organizationId: orgId, provider: "paddle", providerRef: "sub_live", status: "active", planCode: "pro", lastEventAt: new Date(Date.now() - 86_400_000) },
+    });
+  });
+  afterEach(() => vi.unstubAllEnvs());
+
+  it("🚨 denetim geçti → hesap silindi → ödemeli olay: operatöre 'bağlanamayan ödeme' alarmı", async () => {
+    interleave = async () => {
+      await prisma.organization.delete({ where: { id: orgId } });
+    };
+    expect((await post(renewal("evt_race"))).status).toBe(200);
+    expect(await prisma.organization.count({ where: { id: orgId } })).toBe(0);
+    expect(alarms()).toHaveLength(1); // ⬅️ ESKİDE 0 (0 satır güncelleme "bayat olay" sayılıyordu)
+  });
+
+  it("KONTROL: araya bir şey girmezse abonelik güncellenir, alarm yok", async () => {
+    expect((await post(renewal("evt_ok"))).status).toBe(200);
+    expect((await prisma.subscription.findUniqueOrThrow({ where: { organizationId: orgId } })).customerId).toBe("ctm_1");
+    expect(alarms()).toHaveLength(0);
+  });
+
+  it("KONTROL: gerçekten BAYAT olay (daha taze olay yazılmış) alarmsız düşer", async () => {
+    await prisma.subscription.update({ where: { organizationId: orgId }, data: { lastEventAt: new Date(Date.now() + 60_000) } });
+    expect((await post(renewal("evt_stale"))).status).toBe(200);
+    expect((await prisma.subscription.findUniqueOrThrow({ where: { organizationId: orgId } })).customerId).toBeNull();
+    expect(alarms()).toHaveLength(0);
+  });
+});
