// DENEME KİMLİĞİ İZİ (migration 61, kurucu onayı 10-10; `lib/billing/trial-identity.ts`). Aynı ilan / takvimle ikinci ücretsiz denemeyi
// önlemek için işletmeyi dışarıdan tanımlayan kimliğin GERİ DÖNDÜRÜLEMEZ özeti (HMAC; ad / e-posta / URL YOK). SAĞLAYICIDAN BAĞIMSIZ (kurucu:
// "Hospitable üzerine kurmuş gibi yapma"): ilan = kanal adı + ilan numarası; iCal'den çıkarılan Airbnb ilan numarası; diğer iCal adresleri
// normalize edilmiş biçimiyle. Hesap silinince iz KALIR (`firstOrganizationId` boşa çekilir) — yoksa hesabı silip yeniden deneme alınırdı;
// son görülmeden 24 ay sonra süpürülür (kurucu: "24 ay"). Yazıcı `TRIAL_IDENTITY_ENABLED` arkasında KAPALI.
// ---------------------------------------------------------------------------
model TrialIdentity {
  id                  String        @id @default(cuid())
  keyHash             String        @unique
  keyType             String // ota_listing | ota_calendar
  firstOrganizationId String?
  firstSeenAt         DateTime      @default(now())
  lastSeenAt          DateTime      @default(now())
  firstOrganization   Organization? @relation(fields: [firstOrganizationId], references: [id], onDelete: SetNull)

  @@index([firstOrganizationId])
  @@index([lastSeenAt])
}

// ---------------------------------------------------------------------------
// KAYIT AĞI İZİ (K1, kurucu 10-17 "IP'lere bakılsın; otomatik kesme yok", migration 72; `lib/billing/signup-network*.ts`). Yeni hesap kaydında
// BİR satır. HAM IP YOK: tam adres ve ağ öneki (IPv4 /24, IPv6 /48) ayrı ayrı anahtarlı özet (HMAC-SHA256; anahtar ENCRYPTION_KEY ||
// AUTH_SECRET'ten AYRI tuzla türetilir). Takma adlı kişisel veri: amaç YALNIZ deneme kötüye kullanımı İNCELEMESİ (otomatik karar yok), süre
// dolunca (`expiresAt`) silinir. Hesap silinince iz süre dolana kadar kalır (`organizationId` boşa çekilir — sil-yeniden-aç görünsün).
// Yazıcı `SIGNUP_NETWORK_TRACE_ENABLED` arkasında KAPALI (aydınlatma metni yayınlanmadan açılmaz).
// ---------------------------------------------------------------------------
model SignupNetworkTrace {
  id             String        @id @default(cuid())
  organizationId String?
  /// HMAC("ip|" + tam adres); NULL = adres okunamadı
  ipHash         String?
  /// HMAC("net|" + önek); NULL = adres okunamadı
  networkHash    String?
  /// v4_24 | v6_48 (kapalı küme)
  networkKind    String?
  /// Özet anahtarının parmak izi — anahtar değişirse eski satırlar karşılaştırmaya GİRMEZ
  keyFp          String
  createdAt      DateTime      @default(now())
  /// Süpürge anı (createdAt + saklama süresi)
  expiresAt      DateTime
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([ipHash, createdAt])
  @@index([networkHash, createdAt])
  @@index([organizationId])
  @@index([expiresAt])
  @@index([keyFp, createdAt])
}

// AÇIK TAAHHÜT HAFIZASI A (kurucu kararı 10-10; migration 62). Misafire VERİLEN SÖZ ("havlular 18:00'e kadar") YALNIZ ev sahibinin AÇIK
// işaretinden doğar — yapay zekâ / metin yorumu YOK (yanlış "söz verildi" alarmı olmaz). METİN SAKLANMAZ: tür kapalı küme + son an.
// Söz bir göreve bağlanır; görev `done` olunca söz kapanır (görev geri açılırsa söz de açılır), görev silinirse söz iptal olur. Süresi
// yaklaşan / geçen açık söz "Dikkat Gerektirenler"de görünür. Konuşmayla birlikte silinir; konuşma birleştirmede kazanana taşınır.
model GuestCommitment {
  id             String    @id @default(cuid())
  organizationId String
  conversationId String
  taskId         String?
  kind           String // towels | supplies | cleaning | maintenance (lib/guest-commitments.ts kapalı küme)
  /// Sözün KONUSU (I1, kurucu 10-17 "A", migration 73): kapalı küme kısa kod (`guest-commitments-core.ts` COMMITMENT_TOPICS — ac · faucet ·
  /// shampoo …). YALNIZ öneri yolu yazar (ev sahibinin mesajından, kodla); elle form NULL. NULL = konu bilinmiyor (elle söz, konusuz öneri,
  /// bu kolondan önceki satır). Serbest metin / misafir metni TAŞIMAZ. Aynı saatte iki farklı konu = iki söz + iki görev.
  topic          String?
  dueAt          DateTime
  status         String    @default("open") // open | done | cancelled
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  // Migration 68 (kurucu D3, 10-15 "İstek kimliği şimdi"): istemcinin işlem kimliği. Aynı söz isteğinin tekrarı (çift tık / kopan
  // bağlantı) aynı kaydı döndürür; aynı kimlik FARKLI içerikle gelirse açık uyuşmazlık (409). NULL = eski satır / kimliksiz çağıran.
  clientRequestId String?

  /// Migration 75 (kurucu 10-17 gece: "saati belirtilmemiş saati söyleyemez"): zaman kesinliği — time (açık saat) · part (gün dilimi) · day
  /// (yalnız gün). NULL = eski satır (açık saat). part / day sözünde `dueAt` pencerenin SONUDUR (yalnız gecikme hesabı; gösterilmez).
  duePrecision    String?
  /// Gün dilimi kodu (morning · noon · afternoon · late_afternoon · evening · night · midnight · soon) — yalnız duePrecision = part.
  dayPart         String?
  /// Kaynak: auto (ev sahibinin mesajından ONAYSIZ) · suggestion (öneriden onaylı) · NULL (elle form / eski satır).
  source          String?
  /// Sözün çıktığı ev sahibi mesajı — düz kimlik (FK YOK: mesaj saklama süresiyle silinebilir; metin taşımaz).
  sourceMessageId String?
  /// Bağlamla saat güncellemesinin izi ("10:00 → 11:00"): güncellemeden önceki son an.
  previousDueAt   DateTime?
  /// Kapanış sebebi: stay_ended (konaklama bitti — havlu / malzeme / temizlik sözü; arıza kapanmaz) · NULL.
  closedReason    String?
  /// Migration 76 (gece-4, Opus F4/F5): sözü YAPAN — visit (teknisyen / temizlikçi gelecek) · delivery (getireceğim / göndereceğim) · NULL
  /// (bilinmiyor: elle form, eski satır). Öneri yolu yazar (ev sahibinin mesajından, kodla). Yazma katmanı aynı andaki BAŞKA yapanın sözüne
  /// birleştirmez (kilit içinde); bağlam eşleşmesi kaynağı yeniden okumaz. Metin taşımaz.
  actor           String?

  // Konuşma başına tekil (NULL'lar çakışmaz → mevcut satırlarla açılışta patlamaz).
  @@unique([conversationId, clientRequestId])
  // Günlük otomatik söz sınırı (işletme başına günde 20) sayımı.
  @@index([organizationId, createdAt])
  // Dikkat Gerektirenler: org'un açık sözleri, son ana göre.
  @@index([organizationId, status, dueAt])
  @@index([conversationId])
  @@index([taskId])
}

// ---------------------------------------------------------------------------
// GEÇMİŞTEN ÖĞREN (migration 65, kurucu 10-15: "migration ile, en sağlamı"; tasarım `docs/TASARIM-2026-10-15-gecmisten-ogren.md`).
// Dört YENİ tablo (dolu tabloya dokunulmaz). Metin YALNIZ: model taslağı (maskeli ev sahibi cevaplarından) · ev sahibinin kendi notu /
// talimatı · karşılaştırma cevabı (maskeli soruya üretilmiş). Misafir metni SAKLANMAZ — örnek, kaynak mesaj kimliğinden CANLI okunur
// (saklama süresi / silme mesajla birlikte işler). Mülk / işletme silinince kademeli silinir.
// ---------------------------------------------------------------------------
model HistoryLearnRun {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  /// Başlatan kullanıcı (FK yok — kullanıcı silinse de iz kalır; kişisel veri değil, kimlik).
  requestedById  String?
  /// learn (taslak çıkarımı) | compare (cevap karşılaştırma) — app-enforced
  kind           String    @default("learn")
  /// queued | running | done | failed (app-enforced)
  status         String    @default("queued")
  model          String
  effort         String?
  pairCount      Int       @default(0)
  draftCount     Int       @default(0)
  calls          Int       @default(0)
  failedCalls    Int       @default(0)
  tokensIn       Int       @default(0)
  tokensOut      Int       @default(0)
  /// Kapalı küme hata kodu (metin yok).
  errorCode      String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  drafts       HistoryLearnDraft[]

  @@index([organizationId, createdAt])
  @@index([propertyId, status])
}

model HistoryLearnDraft {
  id                     String    @id @default(cuid())
  runId                  String
  propertyId             String
  category               String
  title                  String
  content                String
  supportConversations   Int       @default(0)
  newestMonth            String?
  oldestMonth            String?
  conflict               Boolean   @default(false)
  conflictNote           String?
  /// JSON dizi — `DRAFT_FLAGS` kapalı kümesi.
  flagsJson              String    @default("[]")
  /// JSON dizi — kanıt ev sahibi mesaj kimlikleri (PII yok; örnek canlı okunur).
  evidenceMessageIdsJson String    @default("[]")
  /// pending | approved | rejected | superseded (app-enforced; superseded = aynı mülkün daha yeni temiz okuması geldi)
  state                  String    @default("pending")
  /// Onayla oluşan bilgi tabanı kalemi (FK YOK — KB silme HARD DELETE).
  kbItemId               String?
  reviewedById           String?
  reviewedAt             DateTime?
  createdAt              DateTime  @default(now())

  run      HistoryLearnRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([propertyId, state])
}

/// Mülke özgü ev sahibi talimatı ("böyle yapsın" notu). Cevap istemine YALNIZ `active` + anahtar açıkken ve kod kapılarından geçmişse girer.
model PropertyInstruction {
  id             String    @id @default(cuid())
  organizationId String
  propertyId     String
  content        String
  /// host_note | history_learn | preset (app-enforced)
  source         String    @default("host_note")
  /// Hazır seçenek anahtarı (`instruction-presets.ts`); serbest metinde NULL. Müşteri yalnız hazır seçenek açar / kapatır (kurucu 10-15).
  presetKey      String?
  /// Serbest metni operatör mü yazdı (Opus 10-15 HL4 F4): müşteri serbest metin anahtarı kapanınca müşterinin yazdığı satır isteme
  /// GİRMEZ (görünmeyen / kaldırılamayan yönlendirme olmasın); operatörün ve hazır seçeneğin satırı girer.
  byOperator     Boolean   @default(false)
  /// active | retired (app-enforced)
  status         String    @default("active")
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  retiredAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, status])
  @@index([organizationId])
}

/// Cevap karşılaştırma: ev sahibinin o zamanki cevabı (kimlikle, canlı okunur) ↔ bugünkü yapay zekâ cevabı (GÖNDERİLMEZ) + karar + not.
model HistoryLearnComparison {
  id                       String   @id @default(cuid())
  propertyId               String
  runId                    String?
  questionMessageId        String
  hostAnswerMessageIdsJson String   @default("[]")
  aiAnswer                 String?
  /// Bugünkü kod kapısı bu cevabı otomatik gönderir miydi (GÖNDERİLMEDİ — yalnız gösterim); kapanırsa kapalı küme sebep.
  wouldAutoSend            Boolean?
  gateDetail               String?
  /// Cevabı üreten model — ölçüm izi. `promptId` bugün YAZILMIYOR (migration 65 itildikten sonra kolon düşürülmedi; ileride istem kimliği).
  model                    String?
  promptId                 String?
  /// good | fix | bad (app-enforced)
  verdict                  String?
  note                     String?
  createdById              String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, questionMessageId])
  @@index([runId])
}

/// Doğrulanmış cevap tekrarı (migration 85; tasarım docs/TASARIM-2026-10-23-dogrulanmis-cevap-tekrari.md). Daire başına, ihtiyaç başına
/// doğrulanmış cevap parçası. Misafir metni / kimliği / konuşma bağı YOK: `query` anlama katmanının Türkçe arama sorgusu (ad / sır / bağlantı
/// / saldırı süzgecinden geçmiş). Yalnız gölge kipte yazılır (`AI_ANSWER_REUSE_SHADOW_ENABLED`); misafire bu tablodan hiçbir şey GİTMEZ.
model VerifiedAnswer {
  id               String    @id @default(cuid())
  organizationId   String
  propertyId       String
  kind             String
  language         String
  query            String
  partText         String
  evidence         String
  sourceRef        String // kb:<id> | property
  fingerprint      String
  confirmations    Int       @default(1)
  /// Teyit veren konuşmaların iz özetleri (kimlik değil; aynı konuşma iki kez teyit sayılmaz — Opus güvenlik 10-23 F7). En çok 10.
  conversationKeys String[]  @default([])
  /// Gölge ölçüm: kayıt bu ihtiyaca kullanılabilir bulundu (misafire yine taze cevap gitti).
  shadowHits       Int       @default(0)
  /// Gölge ölçüm: kullanılabilir bulunan kayıt, o turun taze doğrulanmış cevabıyla AYNI bilgiyi vermedi (hedef 0).
  shadowMismatches Int       @default(0)
  lastConfirmedAt  DateTime
  lastHitAt        DateTime?
  disabledAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, kind, language])
  @@index([organizationId])
}

/// EV SAHİBİ KANAL BAĞLANTISI (migration 88, kurucu 10-30 "WhatsApp'ı hemen bağla"; tasarım `docs/TASARIM-2026-10-30-whatsapp-ev-sahibi-dongusu.md` §6).
/// Ev sahibinin bildirim aldığı adres (ilk sağlayıcı WhatsApp). Numara şifreli + HMAC arama anahtarı; düz numara saklanmaz.
model HostChannelBinding {
  id               String    @id @default(cuid())
  organizationId   String
  userId           String
  provider         String // whatsapp_cloud | fake (uygulama kapalı küme)
  addressHash      String // HMAC-SHA256(HOST_CHANNEL_HMAC_SECRET, provider + E.164) — gelen mesajı bulma anahtarı
  addressEnc       String // şifreli E.164 (aad = id) — maskeli gösterim
  status           String    @default("pending") // pending | active | revoked
  verifyCodeHash   String?
  verifyExpiresAt  DateTime?
  verifyAttempts   Int       @default(0)
  verifiedAt       DateTime?
  optInAt          DateTime?
  optInTextVersion String?
  userSessionEpoch Int       @default(0) // doğrulama anındaki User.sessionEpoch; farklıysa askıda
  lastInboundAt    DateTime? // ev sahibinden son gelen mesaj (serbest metin penceresi)
  revokedAt        DateTime?
  revokedReason    String? // user | opt_out | epoch | operator | provider_blocked
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, addressHash])
  @@index([organizationId, status])
  @@index([userId])
}

/// EV SAHİBİNE SORU (migration 88): bir misafir turu için ev sahibine giden soru ve cevabının yaşam döngüsü. Misafir metni / adı SAKLANMAZ;
/// ev sahibinin cevabı ve taslak şifreli, soru bitince 7 gün sonra boşaltılır; satır 90 günde silinir.
model HostQuestion {
  id                String    @id @default(cuid())
  organizationId    String
  conversationId    String
  bindingId         String? // düz kimlik (bağlantı silinse de iz kalır)
  kind              String // info | decision | alert
  turnMessageId     String // turun son misafir mesajı (düz kimlik)
  itemIdsJson       String? // opak öğe kimlikleri (JSON string[])
  decisionId        String?
  status            String    @default("queued")
  version           Int       @default(0) // CAS
  idempotencyKey    String // "turn:<turnMessageId>" | "decision:<decisionId>:v<n>"
  providerMessageId String?   @unique
  previewMessageId  String?   @unique
  answerMessageId   String?   @unique
  answerEnc         String?
  draftEnc          String?
  draftHash         String?
  draftLang         String?
  composeCount      Int       @default(0)
  resultMessageId   String?
  fallbackEmailAt   DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  answeredAt        DateTime?
  expiresAt         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status])
  @@index([conversationId, status])
  @@index([bindingId, status])
}
