// Lixus AI - Prisma schema
// ----------------------------------------------------------------------------
// PostgreSQL (Railway). Conventions kept portable + simple:
//   * "enum-like" fields are plain Strings, validated in the app layer (Zod).
//   * JSON payloads are stored as String (JSON.stringify / JSON.parse).
// Deploy applies REAL migrations at boot via `prisma migrate deploy` (see
// Dockerfile + docs/MIGRATION_CUTOVER.md). RULE: every schema edit needs a
// migration file (prisma migrate diff), verified on a throwaway Postgres.
// Never add a `@unique`/required-no-default column to a POPULATED table.
// ----------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Cross-instance mutex. A holder writes a future `lockedUntil`; others can only
// acquire once that time has passed (or the holder releases by resetting it),
// so the scheduled sync runs once at a time even across multiple replicas.
model SystemLock {
  name        String   @id
  lockedUntil DateTime
  // Fencing token: a random value written by whoever currently holds the lock.
  // releaseLock only clears the row when this still matches its own token, so a
  // run that overran the TTL can't wipe the lock a newer run has since taken.
  holder      String?
  updatedAt   DateTime @updatedAt
}

// Distributed fixed-window rate-limit counters (multi-replica safe; replaces the
// per-instance in-memory map as the AUTHORITY — memory stays as DB-error fallback).
// One row per active key; hits are a single atomic INSERT ... ON CONFLICT upsert
// on the DB clock. Expired rows are reset in place on next hit and swept by the
// scheduled sync. No FK on purpose: keys span orgs, IPs and users.
model RateLimitCounter {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

// Public "request a demo / free trial" leads captured from the marketing landing
// page (no account yet). The operator reviews these in the Operator Panel.
model Lead {
  id         String    @id @default(cuid())
  name       String
  email      String
  phone      String?
  message    String?
  handled    Boolean   @default(false)
  // Mini sales pipeline (operator panel): new → contacted → demo → won | lost.
  status     String    @default("new")
  note       String? // operator's follow-up note
  followUpAt DateTime? // when to get back to this lead
  consentAt  DateTime? // KVKK açık rıza zaman damgası (onay kutusu işaretlendiğinde)
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

model Organization {
  id                         String    @id @default(cuid())
  name                       String
  plan                       String    @default("free") // free | pro | business
  timezone                   String    @default("Europe/Istanbul")
  language                   String    @default("tr") // default UI/AI language
  // Where this org's urgent complaint/refund alert e-mails go. Per-tenant: each
  // customer sets their OWN address. Falls back to the ALERT_EMAIL env when null.
  alertEmail                 String?
  // Per-tenant automation prefs (each customer controls their own):
  //  - autoReplyDisclosure: append the "(machine-prepared)" note to AUTO sends.
  //  - handoffHoldHours: hours the AI stays silent after a guest asks for a human.
  autoReplyDisclosure        Boolean   @default(true)
  handoffHoldHours           Int       @default(12)
  // Tier-2 "holding acknowledgement": when ON, a MILD complaint (no money/legal/
  // safety/threat signals) gets one immediate, deterministic non-committal ack
  // ("passed to our host, sharing a detail helps") while STILL escalating to the
  // host as before. OPT-IN per org, default OFF — the landing promise ("complaints
  // are never auto-answered") stays true unless the host knowingly enables this.
  autoHoldingReplyEnabled    Boolean   @default(false)
  // Opt-in courtesy reply to a bare closing "teşekkürler / thanks / 👍" (default OFF =
  // today's behavior: such closings are silently skipped). When ON, ONE deterministic
  // "you're welcome" line goes out in the guest's language — never twice in a row
  // (a thanks to the courtesy itself is always left alone, so no pleasantry ping-pong).
  autoClosingReplyEnabled    Boolean   @default(false)
  // Host-written courtesy line (optional). When set, it is sent VERBATIM for every
  // closing regardless of the guest's language (the host owns the words); when
  // null/empty, the built-in short per-language default goes out ("Rica ederiz!").
  closingReplyText           String?
  // Host-written late-checkout / stay-extension offer (optional; opt-in by simply
  // filling it in — empty = today's behavior where the AI never quotes a price and
  // just defers to the host). When set, and ONLY when a guest actually asks about a
  // late checkout / extending their stay, the AI MAY surface this offer (including
  // any price the host wrote) as the host's standing terms — an explicit exception
  // to the "never write a price" rule (Section 7.5), scoped to THIS host-owned text.
  // The AI stays PAYMENT-METHOD-NEUTRAL (never says cash NOR "via the platform") and
  // still routes the final confirmation to the host — the host arranges collection.
  lateCheckoutOfferText      String?
  // Smart operational-task routing (opt-in, default OFF): when ON, a guest message
  // that escalates to the host AND carries a physical-operations signal
  // (maintenance / restock / cleaning) also opens a deduped, SLA-dated task so the
  // host can action it — not just a "problem" flag + email. Additive & reversible;
  // OFF = today's behavior (escalation only, no task on the channel-sync path).
  autoTaskFromMessageEnabled Boolean   @default(false)
  // Opt-in (default OFF): when a guest message EXPLICITLY asks for extra linen/towels,
  // add +1 to that property's prep plan. Off = the detector never runs. Kept opt-in
  // because message parsing is imperfect — the host chooses to trust it.
  autoSupplyRequestEnabled   Boolean   @default(false)
  // iCal privacy: the public per-property calendar feed (subscribed to by Airbnb/
  // Booking/Google Calendar) HIDES the guest's name by default — KVKK data
  // minimization, the feed only needs busy/free dates. A host who wants the name
  // in their own calendar can opt in. Applies to every property feed of the org.
  icalShowGuestName          Boolean   @default(false)
  // QR concierge PIN — STRICT mode (Faz 5, #14; opt-in, default OFF). When OFF, a
  // stay requires a PIN only if the host generated one for THAT reservation
  // (gentle opt-in, no surprise). When ON, EVERY not-yet-claimed stay requires a
  // PIN — a reservation with no PIN is fail-closed (chat locked until the host
  // generates one), fully closing the turnover / wrong-scanner gap. Only takes
  // effect while the global QR_PIN_ENABLED env switch is on.
  qrChatPinRequired          Boolean   @default(false)
  // When true, safe/high-confidence channel (Airbnb / Booking via Hospitable)
  // guest messages are auto-answered; gated to active-hours window in org timezone.
  // Complaints and risky messages always wait for a human.
  autoReplyHospitable        Boolean   @default(false)
  autoReplyStartHour         Int       @default(0) // window start hour 0-23 (inclusive)
  autoReplyEndHour           Int       @default(0) // window end hour 0-23 (exclusive)
  aiReplyTone                String    @default("warm") // AI reply tone: formal | warm | short | luxury
  aiSignature                String? // optional sign-off appended to every AI reply (host name + contact)
  autoWelcome                Boolean   @default(false) // send the per-apartment welcome message on reservation confirmation
  autoCheckin                Boolean   @default(false) // send the per-apartment check-in info message a few days before arrival
  autoCheckout               Boolean   @default(false) // send the per-apartment check-out message on departure day (08:00)
  autoReplyEnabledAt         DateTime? // when night auto-reply was last switched on (only answer messages after this)
  autoWelcomeEnabledAt       DateTime? // when welcome was switched on (only greet bookings created after this — never the backlog)
  autoCheckinEnabledAt       DateTime? // when check-in info was switched on (only message bookings created after this)
  autoCheckoutEnabledAt      DateTime? // when checkout was switched on (only message bookings created after this)
  aiStyleProfile             String? // distilled guide of the host's own reply style, learned from past messages
  aiStyleProfileAt           DateTime? // when the style profile was last refreshed (throttles regeneration)
  // Per-customer Hospitable connection (multi-tenant). Each org connects its OWN
  // Hospitable account; the Personal Access Token is stored ENCRYPTED here (see
  // lib/crypto). Null = not connected — the "primary" org may instead fall back
  // to the global HOSPITABLE_API_TOKEN env (see lib/hospitable-credentials).
  hospitableTokenEnc         String?
  hospitableLabel            String? // human label for the connected account (e.g. "8 mülk")
  hospitableConnectedAt      DateTime? // when this org connected its own Hospitable token
  // OAuth-connected orgs only (the "Hospitable ile Bağlan" flow). A pasted PAT
  // never expires, so these stay null for PAT connections — getOrgHospitableToken
  // treats null hospitableTokenExpiresAt as "doesn't expire" (existing behavior,
  // unchanged) and only refreshes when this is set and in the past.
  hospitableRefreshTokenEnc  String? // encrypted OAuth refresh token
  hospitableTokenExpiresAt   DateTime? // when hospitableTokenEnc's access token expires
  // On-hand supply stock { supplyItemKey: qty } — subtracted from the prep plan so
  // /hazirlik shows the NET shortfall ("net alınacak") instead of the gross need.
  // Null/empty = not tracked → plan shows gross (today's behavior). Org-level: a
  // host buys supplies centrally, so stock is a single pool, not per-apartment.
  supplyStockJson            String?
  // Deneme kimliği istisnası (migration 61, kurucu onayı 10-10): operatör "denemeyi geri ver" dediğinde true — aynı ilan / iCal başka
  // hesapta görülse de bu kuruluşun denemesi bitirilmez (meşru durum: ilan yeni sahibe geçti vb.).
  trialIdentityExempt        Boolean   @default(false)
  /// K1-B (kurucu 10-17 "otomatik kesme yok", migration 72): deneme kimliği (ilan / takvim) başka hesapta görüldü — SİNYAL; deneme BİTİRİLMEZ,
  /// operatör listesinde "ilan daha önce kullanıldı" görünür. NULL = görülmedi. İlk gözlem kazanır.
  trialIdentityReusedAt      DateTime?
  /// Kartla deneme kapısı (kurucu 10-17, migration 74): deneme sürerken risk puanı YÜKSEK bantta (ağ / IP sinyalleri HARİÇ) → saatlik iş
  /// damgalar; `TRIAL_CARD_GATE_ENABLED` + faturalandırma zorunluyken otomatik işler kart eklenene kadar durur. Puan düşünce silinir.
  trialCardRequiredAt        DateTime?
  /// Operatör kartla deneme kapısından MUAF tuttu ("Kart şartını kaldır"; Haiku 10-17) — saatlik iş bu işletmeyi bir daha damgalamaz.
  trialCardExemptAt          DateTime?
  /// Migration 75 (kurucu 10-17 gece): ev sahibinin mesajındaki sözden ONAYSIZ görev açılır mı (Ayarlar → "Mesajlarımdaki sözlerden görev aç").
  /// Varsayılan AÇIK; kapalıyken söz önerisi de çıkmaz.
  autoCommitmentsEnabled     Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  users                 User[]
  trialIdentities       TrialIdentity[]
  signupNetworkTraces   SignupNetworkTrace[]
  riskEvents            RiskEvent[]
  shadowVerdicts        ShadowVerdict[]
  erasureTombstones     ErasureTombstone[]
  messageOutbox         MessageOutbox[]
  automatedMessageSends AutomatedMessageSend[]
  channelConnections    ChannelConnection[]
  autoMessageTemplates  AutoMessageTemplate[]
  kbCopyOperations      KbCopyOperation[]
  checkoutIntents       CheckoutIntent[]
  channelListings       ChannelListing[]
  aiGenerations         AiGeneration[]
  ingestEvents          IngestEvent[]
  signals               Signal[]
  propertyMemories      PropertyMemory[]
  verifiedAnswers       VerifiedAnswer[]
  conversationItems     ConversationItem[]
  decisionRequests      DecisionRequest[]
  guestCommitments      GuestCommitment[]
  properties            Property[]
  automationRules       AutomationRule[]
  auditLogs             AuditLog[]
  messageTemplates      MessageTemplate[]
  subscription          Subscription?
  invoices              Invoice[]
  checkoutConsents      CheckoutConsent[]
  operationalEvents     OperationalEvent[]
  historyLearnRuns      HistoryLearnRun[]
  propertyInstructions  PropertyInstruction[]
  hostChannelBindings   HostChannelBinding[]
  hostQuestions         HostQuestion[]
}

model User {
  id                    String    @id @default(cuid())
  organizationId        String
  name                  String
  email                 String    @unique
  passwordHash          String
  role                  String    @default("owner") // owner | manager | staff
  // Two-factor auth (TOTP / authenticator app). Secret stored ENCRYPTED (see
  // lib/crypto). 2FA is ACTIVE only once twoFactorEnabledAt is set (after the
  // user confirms a first code), so a half-finished setup never locks anyone out.
  twoFactorSecret       String?
  twoFactorEnabledAt    DateTime?
  // Last accepted TOTP time-step — rejects replay of an already-used code.
  twoFactorLastStep     Int?
  // Password-change e-mail verification: a short-lived 8-digit code is e-mailed
  // to the user and stored here HASHED (never plaintext). Changing the password
  // requires entering the matching, unexpired code — it proves control of the
  // inbox, so no current password is needed (and a stale logged-in session alone
  // can no longer silently change the password).
  pwChangeCodeHash      String?
  pwChangeCodeExpiresAt DateTime?
  pwChangeCodeAttempts  Int       @default(0)
  // Forgot-password RESET (logged OUT) — separate from pwChangeCode* so a public
  // reset request can never burn/overwrite a code the user is mid-using in Settings.
  // ⚠️ FAZ 3'te KALDIRILACAK (eski akış). `PasswordResetChallenge` bunların
  // yerini alıyor; geçiş penceresi boyunca uçuştaki kodlar için duruyorlar.
  pwResetCodeHash       String?
  pwResetCodeExpiresAt  DateTime?
  pwResetCodeAttempts   Int       @default(0)
  // E-mail verification (self-serve sign-up anti-bot). Null emailVerifiedAt = not
  // yet verified. The link token is stored sha256-HASHED (deterministic so it can
  // be looked up by hash). Existing users (created before EMAIL_VERIFY_REQUIRED_FROM)
  // are NEVER gated at login, so this can't lock out the founder / current accounts.
  emailVerifiedAt       DateTime?
  emailVerifyTokenHash  String?
  emailVerifyExpiresAt  DateTime?
  // KVKK: when the user accepted Terms + Privacy at sign-up (informed-consent
  // record). Nullable → existing accounts (created before the consent checkbox)
  // stay valid and are never blocked.
  acceptedTermsAt       DateTime?
  // KVKK consent EVIDENCE (all nullable → existing accounts untouched, safe on a
  // populated table). privacyAcceptedAt = the moment Privacy was accepted (same
  // click as Terms today); acceptedLegalVersion = which legal-text release was
  // shown (LEGAL_VERSION); acceptedIp/acceptedUserAgent = the request context at
  // sign-up. Together they back an "I never accepted" dispute with a real record.
  privacyAcceptedAt     DateTime?
  acceptedLegalVersion  String?
  // Tamper-evident companion to acceptedLegalVersion: a sha256 of the ACTUAL
  // legal-page text at signup (see lib/legal-text-hash.ts), so a forgotten
  // LEGAL_VERSION bump on a real text edit can't silently understate what the
  // user saw. Nullable — existing accounts predate this field.
  acceptedLegalTextHash String?
  acceptedIp            String?
  acceptedUserAgent     String?
  // Session invalidation counter. Bumped on password change/reset → a stolen JWT
  // (which carries the old value) stops matching, so it dies within one request
  // instead of surviving up to 14 days. Defaulted → db-push safe + no mass-logout
  // on deploy (existing users + legacy tokens both read 0).
  sessionEpoch          Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks    Task[]                   @relation("TaskAssignee")
  taskUpdates      TaskUpdate[]
  auditLogs        AuditLog[]
  checkoutConsents CheckoutConsent[]
  recoveryCodes    TwoFactorRecoveryCode[]
  emailOutbox      EmailOutbox[]
  resetChallenges  PasswordResetChallenge[]

  hostChannelBindings HostChannelBinding[]

  @@index([organizationId])
  // verify-email looks a user up BY token hash on every emailed-link click —
  // that was a full-table scan (rate-limited, but still). Plain index, not
  // unique: 256-bit random values collide never; uniqueness isn't the contract.
  @@index([emailVerifyTokenHash])
}

/// PAROLA SIFIRLAMA CHALLENGE'I — hesap başına DEĞİL, İSTEK başına satır.
///
/// 🚨 TASARIMIN TAMAMI TEK CÜMLEDE: bütçe (deneme sayısı) hesaba değil BU SATIRA
/// aittir ve satırın TEK adresleme yolu `tokenHash`'tir. Token yalnız kullanıcının
/// e-posta kutusuna gider; onu bilmeyen biri satırı BULAMAZ, dolayısıyla
/// denemesini de HARCAYAMAZ.
///
/// Neden gerekti: eski akışta hem `forgot-req:{email}` kovası hem
/// `User.pwResetCodeAttempts` E-POSTAYA göre anahtarlıydı ve e-posta saldırganın
/// serbestçe yazdığı bir istek alanı. Ölçüldü: tek IP'den 9 istek/15 dk ile
/// kurban süresiz olarak sıfırlama dışında tutulabiliyordu. Sayaçları yeniden
/// sıralamak bunu çözmez — anahtar aynı kalır.
///
/// ⚠️ İKİ SIR, AYRI HASH'LER: `tokenHash` = sha256(bağlantıdaki token),
/// `codeHash` = bcrypt(e-postadaki 8 haneli kod). Token ADRESLER, kod
/// YETKİLENDİRİR — sızmış bir URL tek başına parolayı sıfırlayamaz. Düz değerler
/// hiçbir kolonda tutulmaz.
///
/// ⚠️ AYNI ANDA BİRDEN FAZLA CANLI CHALLENGE olabilir ve yeni bir istek eskisini
/// GEÇERSİZ KILMAZ — saldırganın yeni isteklerle kurbanın elindeki geçerli
/// challenge'ı düşürmesini engelleyen şey budur. "Sınırsız" değildir: canlı satır
/// sayısı `forgot-req:{email}` kovası (4/15 dk) ve TTL (30 dk) ile doğal olarak
/// sınırlıdır; süpürge 24 saatte toplar.
model PasswordResetChallenge {
  id            String    @id @default(cuid())
  userId        String
  /// sha256(ham token) — confirm yolunun TEK arama anahtarı (`emailVerifyTokenHash` emsali).
  tokenHash     String    @unique
  /// bcrypt(8 haneli kod). Token'ı ele geçiren biri kodu da bilmeden ilerleyemez.
  codeHash      String
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  expiresAt     DateTime
  /// Tek-kullanım hakemi: paralel iki DOĞRU istekte yalnız biri bunu yazabilir.
  consumedAt    DateTime?
  /// Başarılı bir sıfırlama diğer canlı challenge'ları burada kapatır.
  invalidatedAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

// 2FA recovery codes (Codex #20). One row per single-use code, stored as a
// sha256 HASH — the plaintext exists only in the generation response (shown
// once). Atomic burn = conditional updateMany on usedAt (TOTP-burn pattern).
// Regeneration deletes the user's old rows first (old codes die together).
// Cascade: User is deleted via the Organization cascade on erasure → these
// rows follow automatically. NEW table → zero risk to populated tables.
model TwoFactorRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String // sha256(hex) of the normalized code — NEVER the plaintext
  createdAt DateTime  @default(now())
  usedAt    DateTime? // single-use: set atomically on consume; non-null = dead

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, codeHash])
  @@index([userId])
}

model Property {
  id                    String   @id @default(cuid())
  organizationId        String
  name                  String
  address               String?
  city                  String?
  country               String?
  checkInTime           String   @default("15:00")
  checkOutTime          String   @default("11:00")
  cleaningBufferMinutes Int      @default(120)
  notes                 String?
  // Misafire görünen ad (U4, kurucu 10-22; migration 83): QR sohbet başlığı "<ad> · Misafir Asistanı". Boş → yalnız marka. İç ad (`name`)
  // herkese açık sayfaya ASLA çıkmaz. Yazım / okuma kuralı tek kaynak `lib/guest-display-name.ts`. Additive & nullable.
  guestDisplayName      String?
  // Supply/linen prep profile: JSON object { supplyItemKey: qtyPerArrival } the host
  // fills once (e.g. {"carsaf_takimi":2,"havlu":4,"cop_poseti":2}). Drives the
  // deterministic prep/shopping plan (arrivals-in-range × this). Null = not set →
  // the property is nudged in the plan but blocks nothing. Additive & nullable.
  supplyProfileJson     String?
  icalToken             String?  @unique // secret token for the public iCal export feed
  chatToken             String? // secret token for the public guest QR concierge chat (random 2×UUID → app-level unique; NOT a DB @unique, which would break `db push` on a populated table)
  chatEnabled           Boolean  @default(false) // per-apartment master switch for the public chat (off by default)
  hospitableId          String?  @unique // linked Hospitable property UUID (channel sync)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reservations        Reservation[]
  conversations       Conversation[]
  tasks               Task[]
  knowledgeBase       KnowledgeBaseItem[]
  messageTemplates    MessageTemplate[]
  supplyRequests      SupplyRequest[]
  calendarSources     CalendarSource[]
  signals             Signal[]
  memories            PropertyMemory[]
  verifiedAnswers     VerifiedAnswer[]
  channelListings     ChannelListing[]
  historyLearnRuns    HistoryLearnRun[]
  historyLearnDrafts  HistoryLearnDraft[]
  instructions        PropertyInstruction[]
  historyLearnReviews HistoryLearnComparison[]
  autoMessages        AutoMessageTemplate[]

  @@index([organizationId])
  // Public QR concierge chat resolves a property by its secret chatToken on every
  // guest message; index that lookup (chatToken is app-level unique, not a DB
  // @unique — see the field comment — so a plain index is the right tool).
  @@index([chatToken])
}

// Durable per-apartment daily counter for PAID guest-chat AI calls. The in-memory
// limiter resets on every restart (and isn't shared across replicas), so an
// attacker holding one QR token could re-trigger the cap each boot; this DB-backed
// counter bounds the spend to a true daily cap. One tiny row per apartment/day.
model ChatUsage {
  propertyId String
  day        String // YYYY-MM-DD (UTC) rate window
  count      Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@id([propertyId, day])
  @@index([day]) // optional housekeeping: prune old windows
}

// A subscribed external iCal URL (Airbnb, Booking.com, etc.) that is fetched
// periodically to pull reservations into the property automatically.
model CalendarSource {
  id                     String    @id @default(cuid())
  propertyId             String
  label                  String // "Airbnb", "Booking.com", "Etstur" ...
  url                    String
  lastSyncedAt           DateTime?
  lastStatus             String? // "ok" | "error"
  lastResult             String? // human-readable summary of the last sync
  // Feed-disappearance reconciliation state (migration 31, nullable-first, flag-gated).
  // lastFeedEventCount = # of UIDs in the last RELIABLE feed (suspicious-drop guard baseline);
  // lastReconcileAt = fetch-start of the last reliable reconciliation (stale-run ordering: a
  // slower older run never overwrites a newer one's result).
  lastFeedEventCount     Int?
  lastReconcileAt        DateTime?
  // At-rest encryption of `url` (expand-contract — docs/CALENDAR-URL-ENCRYPTION-DESIGN.md).
  // Feed URLs carry credentials in their query string, so the column is a secret.
  // Phases 0-3: dual-write + read-prefers-urlEnc with plaintext fallback; `url`
  // stays authoritative until the forward-only contract phase, which runs ONLY
  // with explicit user approval. urlKeyFp = ENCRYPTION_KEY fingerprint at write
  // time (wrong key becomes a diagnosable error, not silent garbage).
  urlEnc                 String?
  urlKeyFp               String?
  // Deneme kimliği (migration 61): bu takvim GERÇEKTEN okunduğunda (sunucu geçerli takvim döndürdü) kimliği bir kez sayıldı. Eklemede
  // değil okumada sayılır — herkese açık ilan numarasıyla sahte jetonlu adres eklemek başkasının ilanını "kapamaz".
  trialIdentityCheckedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Reservation {
  id                         String    @id @default(cuid())
  propertyId                 String
  guestName                  String
  guestPhone                 String?
  guestEmail                 String?
  guestExternalId            String? // Hospitable stable guest id — links the SAME person across stays (returning-guest)
  // Misafirin hitap adı (K10-o, migration 57, kurucu kararı 09-28): YALNIZ kanalın AYRI ad alanından (bugün Hospitable
  // `guest.first_name`) — eski `guestName` bölünerek DOLDURULMAZ (tahmin yok; eski satırlar NULL). Misafirin yazdığı metindir:
  // hitap içindir, olgu / talimat DEĞİL, modele ve bilgi tabanına girmez. Saklama / silme / maske `guestName` ile aynı.
  guestGivenName             String?
  // `guestName`in NEREDEN yazıldığı — kapalı küme `lib/guest-name-source.ts` (channel · calendar · file · host · placeholder).
  // Köken etiketidir, "doğrulanmış / güvenilir" DEĞİL. NULL = bu sürümden önce yazılmış, kaynağı gözlenmemiş satır.
  guestNameSource            String?
  arrivalDate                DateTime
  departureDate              DateTime
  channel                    String    @default("manual") // manual | airbnb | booking | direct | other
  status                     String    @default("confirmed") // pending | confirmed | cancelled | completed
  totalAmount                Float?
  // Faz-A shadow (Codex #26, expand/contract): authoritative-in-waiting Decimal
  // twin of totalAmount. Dual-written by every writer; readers prefer this and
  // fall back to the Float. The Float column is NOT dropped/renamed in this
  // phase (old deployments keep writing it during cutover; a deep-sync healing
  // pass backfills any Float-only rows). Faz B/C: flip reads to Dec-only, then
  // drop the Float — separate, later round.
  totalAmountDec             Decimal?  @db.Decimal(12, 2)
  currency                   String    @default("EUR")
  sourceReference            String?
  notes                      String?
  welcomeSentAt              DateTime? // set once the auto welcome message has been delivered
  checkinSentAt              DateTime? // set once the auto check-in info message has been delivered
  checkoutSentAt             DateTime? // set once the auto check-out message has been delivered
  // Feed-disappearance reconciliation (migration 31, nullable-first, flag-gated, source-bound).
  // A confirmed/pending future stay bound to a calendar source whose UID vanishes from CONSECUTIVE
  // RELIABLE feed runs is a candidate for upstream-cancel — but only after BOTH a miss-count
  // threshold AND a minimum wall-clock duration, and reset the moment it reappears.
  feedLastSeenAt             DateTime? // last reliable feed run that still contained this UID
  feedMissingCount           Int? //      consecutive reliable runs missing it (NULL = 0)
  feedFirstMissingAt         DateTime? // when the current missing streak began (min-duration anchor)
  guestCheckoutTime          String? // guest's own stated departure time (e.g. "18:00"); null → use property default
  // Rezervasyondaki kişi / evcil hayvan sayıları (migration 86, kurucu onayı 10-23 akşam: "kimlerin geldiğini kaç kişi evcil hayvan var mı onu
  // görsün"). YALNIZ kanalın kendi sayı alanından yazılır (alan adı gerçek veriyle doğrulanmadan eşleme KAPALI — `HOSPITABLE_GUEST_COUNTS_ENABLED`);
  // tahmin yok, NULL = bilinmiyor (0 değil). Kişisel veri değildir (sayı); modele ve okuyucuya bağlam olarak gider.
  guestAdults                Int?
  guestChildren              Int?
  guestInfants               Int?
  guestPets                  Int?
  // Per-stay QR concierge device binding: the FIRST device to open the chat this
  // stay claims it (sha256 of an httpOnly per-stay secret). Any other device
  // scanning the same fixed physical QR gets no history — so a past guest/cleaner
  // holding the QR photo can't read the current guest's chat. Rotates per stay
  // (each reservation starts null → rebinds fresh). Pseudonymous technical
  // identifier (hash + timestamp, no direct identity) — KVKK classification
  // pending legal confirmation (see docs/saklama-ve-imha-politikasi.md).
  chatBoundHash              String? // sha256(hex) of the current stay's device secret; null = unbound
  chatBoundAt                DateTime? // when this stay's chat was first claimed by a device
  // QR escalation e-mail claim (Codex #15): the atomic send-claim for the LAST
  // escalated QR-chat message the host was e-mailed about. Dedupe is bound to
  // the EVENT (triggering Message id) — the same message can never double-mail,
  // while a genuinely new incident always alerts; the timestamp adds only a
  // SHORT anti-flood cooldown (minutes, not hours). Both nullable → populated-
  // table safe; the whole feature is env-gated (default OFF).
  qrEscalationEmailAt        DateTime?
  qrEscalationEmailMessageId String? // inbound Message id of the last alerted event
  // Per-reservation QR concierge PIN (Faz 5, #14). The host generates a PIN and
  // gives it to the booked guest (e.g. in the check-in message); the guest must
  // enter it to CLAIM this stay's chat on their device — closing the "cleaner /
  // past guest / neighbour scans the fixed QR" gap that first-scan device
  // binding alone left open. Stored as an HMAC(server pepper, reservationId:PIN)
  // — NEVER the plaintext PIN — so a DB read can't recover or offline-brute-force
  // a low-entropy PIN (the pepper is a server secret, not in the DB). The whole
  // feature is env-gated (QR_PIN_ENABLED, default OFF); all fields nullable /
  // defaulted → populated-table safe, old deployments ignore them.
  chatPinHash                String? // HMAC-SHA256 hex of the current PIN; null = no PIN set
  chatPinSetAt               DateTime? // when the PIN was last (re)generated — regeneration overwrites the hash, instantly invalidating the old PIN
  chatPinFailedCount         Int       @default(0) // durable wrong-PIN counter (brute-force lockout; survives restarts + is multi-replica atomic)
  chatPinLockedUntil         DateTime? // when set & in the future, PIN entry is locked (too many wrong attempts)
  // Which iCal CalendarSource imported this row (plain id, no FK — a deleted
  // source simply leaves rows unbound). Feed reconciliation may ONLY cancel rows
  // bound to the SAME source: without this, a feed cancelled every same-channel
  // booking it had never seen (other feeds, Hospitable) — mass-cancel (Codex).
  calendarSourceId           String?
  // V0.4 PROVENANCE (migration 50, additive/nullable, FK YOK — MessageOutbox.connectionId emsali).
  //   connectionId = satırın KANITLANMIŞ sağlayıcı bağlantısı: ya ingest anında yazılır ya da NULL iken
  //     bir senkron satırı O bağlantıdan gerçekten GÖZLEMLEYİNCE doldurulur (NULL→X). Asla X→Y, asla
  //     X→NULL. ÇIKARIM YOK: legacy satıra org/provider tekilliğinden damga basılmaz, "mevcut bağlantıyı
  //     aktar" tarihsel kanıt sayılmaz — pencere dışı legacy satır NULL kalır (= bilinmiyor).
  //     iCal'in kimliği `calendarSourceId`, elle giriş/dosya için NULL.
  //   ingestedAt = İLK ALINMA: bir ingress'in satırı YARATTIĞI an; değişmez (update yolları dokunmaz).
  //     Freshness/"son görülme" BU DEĞİLDİR (iCal: feedLastSeenAt; thread: syncCursorAt). Host'un elle
  //     girdiği satır NULL (ingest değil).
  //   connectionEvidence = damganın NASIL yazıldığı, kapalı küme (app-enforced): "ingest" (satırı yaratan
  //     ingress bu bağlantı altındaydı) | "observed" (NULL iken sonraki senkron gözlemledi — ilk alınmanın
  //     bu bağlantıdan yapıldığı İDDİA EDİLMEZ) | "outbound" (giden Message: kuyruklandığı bağlantı).
  //     connectionId ile birlikte yazılır/ezilmez. Sınıflar: channels/provenance.ts `describeProvenance`.
  connectionId               String?
  connectionEvidence         String?
  ingestedAt                 DateTime?
  // Migration 60 (kurucu onayı 10-09; değişmez 2): sağlayıcının HAM platform dizesi (ör. Hospitable `platform`). Yalnız ingest yazar,
  // yalnız GÖSTERİM / teşhis okur — yetenek ASLA bundan çıkarılmaz (V0.9 pini). NULL = gözlenmedi (eski satır / elle / iCal).
  sourcePlatform             String?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  property       Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  tasks          Task[]
  supplyRequests SupplyRequest[]
  signals        Signal[]

  // Sync de-dup looks up (propertyId, sourceReference) once per reservation on
  // every 2-min cron — index it so that's a seek, not a per-row scan.
  // UNIQUE (was a plain index): one provider/feed reference = one reservation
  // row per property (prod pre-verified duplicate-free after the 114-pair merge).
  // NULL sourceReference (manual rows) stays distinct/unconstrained.
  @@unique([propertyId, sourceReference])
  @@index([propertyId])
  @@index([arrivalDate])
  @@index([departureDate]) // checkout / cleaning / report queries filter by this
  @@index([guestExternalId]) // returning-guest lookup by the stable guest id
  // Org-scoped date-range report aggregates (occupancy / forecast) filter by
  // property AND a date window; composite indexes let those seek instead of
  // scanning the global date index and discarding other orgs' rows at scale.
  @@index([propertyId, arrivalDate])
  @@index([propertyId, departureDate])
}

model Conversation {
  id                     String    @id @default(cuid())
  propertyId             String
  reservationId          String?
  channel                String    @default("manual") // manual | whatsapp | email | airbnb | booking | chat (QR misafir sohbeti — panel bağlantısı buna bakar)
  guestIdentifier        String // name / phone / email used to address the guest
  status                 String    @default("new") // new | waiting | answered | problem | closed
  priority               String    @default("standard") // urgent | standard | low
  lastMessageAt          DateTime  @default(now())
  // Sync skip-check cursor: the provider's reservation.last_message_at as of our
  // last successful import. WRITTEN ONLY by the message-sync (hospitable-sync),
  // never by outbound paths — so it can't be polluted with wall-clock now() the
  // way lastMessageAt is (which caused a fetch→reply-window guest message to be
  // wrongly skipped = message loss). Nullable → db-push/backfill safe (null =
  // "never synced" → import, never skip). Independent of any message's created_at.
  syncCursorAt           DateTime?
  // Channel-provider identifiers (e.g. Hospitable) used to sync messages and
  // send replies back on the original channel (Airbnb, Booking, ...).
  externalReservationId  String? // Hospitable reservation UUID (reply target)
  externalConversationId String? // Hospitable conversation UUID
  // When set & in the future, auto-reply is paused for this thread — the guest
  // asked to speak to a human, so we hand off and let the host take over.
  autoReplyHoldUntil     DateTime?
  // Last time the channel auto-reply pass MODELED this thread and left it "new"
  // (low confidence / globally disabled). Used to skip re-spending a model call on
  // the same unchanged message every tick; a new guest message advances
  // lastMessageAt past this, making the thread eligible again. Nullable → db-push safe.
  autoReplyAttemptedAt   DateTime?
  // Risk visibility (Faz-A): why the AI last held back on this thread (stable
  // per-message reasons only: escalated_to_human | complaint |
  // low_confidence_or_risky | closing_ack | human_hold | reservation_ended;
  // null after a successful auto-send) + the model's last risk verdict.
  skippedReason          String?
  lastRiskLevel          String?
  // Faz-B: WHY risky (closed label set, code-clamped) — reports/inbox only.
  lastRiskType           String?

  // ── m48: SORUNLU KONUŞMA TRİYAJI ────────────────────────────────────────
  // Model escalate ederken "ne yapılmalı" (actionSuggestion) ve "misafirden ne
  // lazım" (missingInfo) ZATEN üretiyordu; ikisi de hiçbir yere yazılmıyor,
  // istek bitince yok oluyordu. Bu altı kolon o ödenmiş analizi saklar —
  // İKİNCİ BİR MODEL ÇAĞRISI YOK (ikinci çağrı KB'siz/rezervasyonsuz olurdu,
  // yani birincisinden KÖTÜ bir analiz üretip kota harcardı).
  //
  // 🚨 TEMİZLEME YOK (kullanıcı+Codex kararı, 08-09): konuşma "problem"den
  // çıkarken bu alanlar SİLİNMEZ. Altı ayrı çıkış noktası var (host cevabı ×2,
  // outbox teslimi, iki geri alma, arayüzden durum değişimi) ve altısına birden
  // dokunmak, birini unutmaktan daha riskli. Alanlar TARİHSEL KAYIT olarak
  // kalır; okuma yüzeyi zaten `status:"problem"` filtreliyor.
  // ⚠️ Sonraki escalation hepsini BİRLİKTE yeniler — AMA yenileme garanti
  // değildir: `applyInboundMessageRules` yolunda tazelik çapası kaymışsa yazma
  // hiç yapılmaz (`count === 0`) ve altı alan eski hâlinde kalırken `status`
  // yine "problem" olur. O satırı `isTriageStale` BAYAT işaretler.
  /// Modelin "ne yapılmalı" önerisi (host'a gösterilir). En fazla 300 karakter.
  aiActionSuggestion       String?
  /// "Misafirden şunlar eksik" listesi — JSON string dizisi. 5 öğe × 80 karakter.
  /// ⚠️ Okuma DAİMA güvenli ayrıştırıcıdan geçer (`/inbox` bir server component;
  /// çıplak `JSON.parse` orada tüm sayfayı 500'ler, yalnız o kartı değil).
  aiMissingInfoJson        String?
  /// Modelin kendi güveni. YALNIZ sonlu değer yazılır ve 0..1'e clamp edilir —
  /// `typeof === "number"` YETMEZ, `NaN`/`Infinity` o kapıdan geçer.
  aiConfidence             Float?
  /// Triyajı HANGİ yol üretti: "model" | "keyword". Kapalı set, kod-clamp.
  /// 🚨 NULL'DAN SEMANTİK ÇIKARMA: "aiConfidence NULL = modele sorulmadı"
  /// çıkarımı YANLIŞ olabilir (model koşup sonlu güven döndürmeyebilir).
  aiTriageSource           String?
  /// Triyajı tetikleyen mesajın id'si. Bayatlık BUNUN üzerinden ölçülür.
  /// ⚠️ FK KURULMAZ: `Message` satırları KVKK süpürgeleriyle anonimleşiyor;
  /// Cascade triyajı da götürür, Restrict süpürgeyi kilitler. Ölü referans
  /// yalnız "bayatlık ölçülemiyor" demektir ve fail-safe yön "bayat say"dır.
  aiTriageTriggerMessageId String?
  /// Triyajın yazıldığı an. `updatedAt` DEĞİL — o her yazmada değişiyor
  /// (mesaj sayacı, durum, okundu işareti) ve bayat analizi taze gösterirdi.
  aiTriagedAt              DateTime?

  // V0.4 PROVENANCE (migration 50) — Reservation'daki yorumla aynı sözleşme (kanıt: ingest ya da gözlem;
  // çıkarım yok; ingestedAt = ilk alınma; connectionEvidence ingest|observed). QR iç thread'in
  // (`qr-chat:`) kimliği işaretçidir → NULL.
  connectionId       String?
  connectionEvidence String?
  ingestedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property      Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation   Reservation?       @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  messages      Message[]
  signals       Signal[]
  items         ConversationItem[]
  decisions     DecisionRequest[]
  // Migration 60: yapay zekâ üretim izi metin taşır (kurucu §D-1) → konuşma silinince iz de gider (silme paritesi).
  aiGenerations AiGeneration[]
  // Migration 62: misafire verilen sözler (metin YOK) — konuşmayla birlikte gider.
  commitments   GuestCommitment[]

  // THREAD IDENTITY (migration 45). One provider thread = at most one row.
  //
  // `importThread` already enforced this in application code (canonical read
  // under the NS-43 advisory lock), but a bare read-then-create cannot survive
  // two runners: the 2026-07-26 production preflight found seven duplicate
  // pairs, every one of them carrying the SAME provider externalConversationId
  // — our own race, not a provider shape. Those pairs were merged; this makes
  // the invariant structural instead of merely intended.
  //
  // NULL SEMANTICS ARE LOAD-BEARING: PostgreSQL treats NULLs as distinct, so
  // manually created conversations (which never set externalReservationId)
  // stay unconstrained — many per property, as the product requires. Do NOT
  // convert this to NULLS NOT DISTINCT; that would collapse manual
  // conversations to one per property and break the product.
  //
  // In practice this binds exactly two writers: the channel sync (provider
  // reservation UUID) and QR guest chat ("qr-chat:{propertyId}:{reservationId}").
  // Their value spaces cannot collide. Both handle the resulting P2002.
  hostQuestions HostQuestion[]

  @@unique([propertyId, externalReservationId])
  @@index([propertyId])
  // Migration 77 (gece-4 S8-01): rezervasyon silinince FK eylemi (SET NULL) her satırda tabloyu taramasın (mülk / hesap silme 15 sn → 0,1 sn).
  @@index([reservationId])
  @@index([status])
  // Kept DESPITE the composite unique above: that index leads with propertyId,
  // so it cannot serve a lookup by externalReservationId alone.
  @@index([externalReservationId])
  @@index([lastMessageAt]) // inbox is ordered by recency
  // Composite for the hot path: inbox/dashboard/cron filter by status and sort
  // by lastMessageAt within an org's properties (one index instead of filter+sort).
  @@index([propertyId, status, lastMessageAt])
}

model Message {
  id                 String    @id @default(cuid())
  conversationId     String
  direction          String // inbound | outbound
  senderName         String
  body               String
  language           String    @default("tr")
  aiSuggestedReply   String?
  aiConfidence       Float?
  aiIntent           String?
  // Faz-B evidence: JSON array of the sources the AI grounded this reply on
  // (e.g. ["kb:wifi","property:checkInTime"]). Auto-sends only; audit trail.
  aiSourcesJson      String?
  externalId         String? // provider message id (e.g. Hospitable) — sync dedup
  // True when this outbound reply was drafted by the AI and approved by a human
  // (one-click "Onayla ve gönder"). Lets reports credit host-approved AI replies,
  // not only fully-automatic "GuestOps AI" sends. Defaulted → db-push safe.
  aiAssisted         Boolean   @default(false)
  // Canonical, typed authorship (migration 28): guest | ai | host | system. This is
  // the RELIABLE classifier — senderName above is DISPLAY/AUDIT only and must never
  // drive a security/state decision. systemEventType names a closed system event when
  // authorType = system (e.g. guest_chat_ai_resumed). NULLABLE: additive on a
  // populated table + old-deployment INSERT compat; new code dual-writes it and reads
  // prefer it (deriveMessageAuthor is the transitional fallback for any NULL row).
  authorType         String?
  systemEventType    String?
  // V0.4 PROVENANCE (migration 50): connectionId = ingest edildiği (sağlayıcıdan gelen HER iki yön)
  // ya da outbox'ta kuyruklandığı bağlantı; doğrudan gönderim yolu ve QR botu NULL. Mesaj satırı
  // yeniden yazılmaz → gözlemle doldurma yok; ingestedAt = ilk alınma (createdAt sağlayıcı zamanıdır).
  // connectionEvidence: ingest (sağlayıcıdan) | outbound (outbox'ta kuyruklandı) — gözlem yok.
  connectionId       String?
  connectionEvidence String?
  ingestedAt         DateTime?
  /// KANALIN BİLDİRDİĞİ GÖNDEREN ROLÜ (L5, migration 71, kurucu 10-17: "sağlayıcı otomasyonu ile ev sahibinin mesajını ayır; Airbnb
  /// Direct'te rol kanal katmanında"). Kapalı küme `CHANNEL_SENDER_ROLES` (message-author.ts): guest · host (insan) · automation (sağlayıcı
  /// şablonu / zamanlanmış / sağlayıcı yapay zekâsı) · unknown (alan var, değer tanınmadı). NULL = kanal rol bildirmedi / bizim yazdığımız
  /// satır / bu kolondan önceki satır. Güvenlik ve "cevap mı" kararı bundan TÜREMEZ (`authorType` tek otorite); yalnız öğrenme / üslup /
  /// öneri girdisi. Metin / kimlik taşımaz.
  channelSenderRole  String?
  createdAt          DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // UNIQUE (was a plain index): the DB is now the dedupe arbiter for imported
  // provider messages — racing syncs get P2002 (treated as dedupe-hit in code).
  // NULL externalId (pre-heal app sends) stays distinct/unconstrained.
  @@unique([conversationId, externalId])
  @@index([conversationId])
  @@index([conversationId, createdAt]) // fetch a thread's latest message fast
}

model Task {
  id              String    @id @default(cuid())
  propertyId      String
  reservationId   String?
  type            String    @default("cleaning") // cleaning | laundry | restock | checkin_prep | checkout_review | maintenance
  title           String
  description     String?
  assignedToId    String?
  dueAt           DateTime?
  status          String    @default("todo") // todo | in_progress | awaiting_review | done
  priority        String    @default("standard") // urgent | standard | low
  checklistJson   String? // JSON-encoded array of { label, done }
  // Smart-task routing (Faz A): the guest Message this task was auto-created from
  // (audit trail; plain id, no FK — the message may be swept by KVKK retention),
  // and an intra-day dedupe key "{propertyId}:{type}:{YYYY-MM-DD Istanbul}" so
  // repeated messages about the same issue on the same day don't pile up. Both
  // null for manually-created and reservation-lifecycle tasks.
  sourceMessageId String?
  dedupeKey       String?
  // Who created this task: manual (host) | system (reservation lifecycle:
  // checkin_prep/cleaning) | ai (message-driven: smart-task / complaint).
  // Cancellation cleanup deletes ONLY origin="system" — a host's own task tied
  // to a reservation must survive the booking being cancelled. DB default is
  // "manual" (fail-safe: an unstamped row is PROTECTED from auto-deletion).
  origin          String    @default("manual")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property    Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation?      @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  assignedTo  User?             @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  updates     TaskUpdate[]
  // Migration 62: bu görevin kapattığı misafir sözü (görev `done` → söz kapanır).
  commitments GuestCommitment[]

  @@index([propertyId])
  @@index([status])
  @@index([assignedToId])
  // createReservationTasks / backfill look up tasks by reservationId per row.
  @@index([reservationId])
  // Smart-task dedupe lookup: findFirst by dedupeKey among non-done tasks.
  @@index([dedupeKey])
}

// A guest's one-off extra-supply request ("bir havlu daha alabilir miyim?") picked
// up from an inbound message. Added to the prep plan so the host prepares the extra
// item. Deduped per triggering message (sourceMessageId). A NEW table → zero risk to
// existing tables; cascades away with the property, reservation link SetNull.
model SupplyRequest {
  id              String   @id @default(cuid())
  propertyId      String
  reservationId   String?
  itemKey         String // one of the SUPPLY_ITEMS keys
  qty             Int      @default(1)
  sourceMessageId String? // the inbound Message it was detected from (dedup)
  createdAt       DateTime @default(now())

  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  // DB-level dedup backstop (new table → safe): one request per (message, item).
  // Postgres treats NULL sourceMessageId as distinct, so manual/no-message rows
  // never collide. Makes the app-level findFirst race-proof.
  @@unique([sourceMessageId, itemKey])
  @@index([propertyId, createdAt])
  // Migration 77 (gece-4 S8-01): rezervasyon silinince FK eylemi (SET NULL) tablo taramasın.
  @@index([reservationId])
}

model TaskUpdate {
  id        String   @id @default(cuid())
  taskId    String
  userId    String?
  status    String?
  note      String?
  photoUrl  String?
  createdAt DateTime @default(now())

  task Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([taskId])
}

// Onay sözleşmesi alanları (A1, migration 53). Kapalı kümeler + karar noktası
// `src/lib/kb-review.ts`; AI erişimi ALLOWLIST (`legacy` + `approved`) ve tek
// boğaz noktası `lib/ai/kb-fetch.ts`.
//
// 🚨 `legacy` bir dolgu değil, DÜRÜSTLÜK kaydıdır: bu sözleşmeden önce yazılmış
// satırların kaynağı/onayı hiçbir yerde tutulmuyordu. Migration onları
// `host_manual`+`approved` DAMGALAMAZ (kurucu, 09-08) — kolon `DEFAULT 'legacy'`
// ile eklenir ve varsayılan ÖYLE KALIR. Yani "kaynağını beyan etmeyen her satır
// legacy'dir": geçmiş satırlar da, yarın kaynağını yazmayı unutan bir kod yolu
// da "bilmiyoruz" der; hiçbiri sahte onay üretmez. Onay AÇIKÇA yazılır
// (`api/kb` POST) — bu yüzden `approved` bir varsayılan DEĞİL, bir eylemdir.
model KnowledgeBaseItem {
  id              String    @id @default(cuid())
  propertyId      String
  category        String    @default("general") // location | checkin | wifi | rules | parking | trash | cleaning | faq | local_tips | general
  title           String
  content         String
  language        String    @default("tr")
  isActive        Boolean   @default(true)
  /// legacy | host_manual | extracted_draft | suggestion_accepted (app-enforced)
  source          String    @default("legacy")
  /// legacy | approved | draft — YALNIZ legacy+approved modele gider (app-enforced)
  reviewState     String    @default("legacy")
  /// Onayın GERÇEK zamanı. `legacy` satırlarda NULL = "onay kaydı yok".
  approvedAt      DateTime?
  /// A5: çıkarımın geldiği metnin PII'SİZ işaretçisi (alıntı DEĞİL). Bugün yazan yok.
  sourceRef       String?
  /// A5: bir öneri kabul edilince eski kalem yenisiyle işaretlenir (iz kaybı yok).
  /// FK YOK — KB silme HARD DELETE'tir, FK silmeyi kilitlerdi (V0.4 provenance ile aynı gerekçe).
  supersededById  String?
  /// Migration 70 (L2, kurucu 10-17 "ev sahibi daha güncel olanı seçince o artık doğru sayılsın"): bu kalemin yerine yenisi konduğu an.
  /// `supersededById` ile BİRLİKTE yazılır (kalem pasif); ev sahibi eskiyi yeniden etkinleştirince ikisi de NULL. `updatedAt` yerine ayrı
  /// alan: sonraki düzenleme / aç-kapa bu anı değiştirmesin — Geçmişten öğren "değişiklikten önceki kanıt" kuralını bu andan okur.
  supersededAt    DateTime?
  /// İçe aktarma tekrar güvenliği (migration 67, kurucu 10-14 "İstek kimliği"): istemcinin kalem başına ürettiği rastgele kimlik.
  /// Aynı mülk + aynı kimlik ikinci kalem AÇMAZ (bağlantı cevap anında koparsa yeniden deneme). Elle eklemede NULL (PG'de NULL'lar çakışmaz).
  clientRequestId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  property Property        @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  vectors  KbChunkVector[]

  // Migration 68 (kurucu D2, 10-15 "Eski kopyayı güncelle"): kopyanın KAYNAĞI ve kopyalandığı (ya da son güncellendiği) andaki içerik izi
  // (SHA-256: kategori + başlık + içerik + dil). Yeniden kopyalamada yalnız bu kaynaktan geldiği doğrulanmış VE iz hâlâ tutan (yerelde
  // değiştirilmemiş) kopya güncellenir; tutmuyorsa üzerine yazılmaz, atlanır. NULL = kopya değil ya da bağı bilinmeyen eski kayıt —
  // benzerliğe göre EŞLEŞTİRİLMEZ (kurucu).
  copiedFromId      String?
  copiedContentHash String?

  @@unique([propertyId, clientRequestId])
  @@unique([propertyId, copiedFromId])
  @@index([propertyId])
  @@index([category])
}

/// Migration 87 — KALICI GÖMME DEPOSU (kurucu 10-23 "Bilgi tabanı iki yeni tablo ana dala", 10-28 "tamamdır … en uzun vadeli en iyi olacak
/// şekilde"; tasarım `docs/TASARIM-2026-10-23-bilgi-tabani-dosya-rag-ve-tarama.md` §10.1 + `docs/TASARIM-2026-10-28-dosya-rag-cumle-ve-anlam.md`
/// §4.2 K1–K7). Bilgi tabanı parçalarının anlam vektörleri yeniden başlatmada kaybolmasın (yayından sonraki ilk misafir sorusu sözcüksele
/// düşmesin). METİN SAKLANMAZ: tablo her zaman yeniden kurulabilir bir önbellektir. Satır yalnız KALEME bağlıdır (kalem → daire → işletme
/// silme zinciri cascade); okuma çağıranın kiracı süzgeçli kalem kimlikleriyle yapılır. Anahtar `KB_VECTOR_STORE_ENABLED` (yalnız "1")
/// kapalıyken tabloya okuma / yazma / silme YOK.
model KbChunkVector {
  id            String   @id @default(cuid())
  kbItemId      String
  /// Gömme modeli (`embeddingModel()`); model değişince eski satırlar açılış temizliğinde silinir.
  model         String
  /// Gömme metninin tarif sürümü (`c1` = bugünkü `embeddingTextFor`). Tarif değişince eski satırlar kalem değişmese de süpürülür.
  recipe        String   @default("c1")
  /// Eşleşme birimi türü (kodda kapalı küme): chunk · sentence · question · item. Bugün yalnız `chunk` yazılır.
  kind          String   @default("chunk")
  /// Tarif GİRDİSİNİN SHA-256 özeti (base64url). Belirlenimci tarifte girdi = gömülen metin (bellek deposunun anahtarıyla aynı).
  inputHash     String
  /// Aynı girdiden birden çok vektör (ileride üretilen sorular) için sıra; bugün hep 0.
  ord           Int      @default(0)
  /// Vektör boyutu; okumada türün izinli boyutlarıyla ve bayt uzunluğuyla (boyut × 4) doğrulanır.
  dims          Int
  /// Float32 küçük-sonlu (little-endian) ham baytlar.
  vector        Bytes
  /// Satırın üretildiği andaki kalem sürümü (`KnowledgeBaseItem.updatedAt`). Yazma yalnız kalem hâlâ bu sürümdeyse yapılır; temizlik
  /// sürüm uyuşmazlığına bakar (saat karşılaştırması yok) → düzenlemeden önce başlamış ısıtma eski metnin satırını bırakamaz.
  itemUpdatedAt DateTime
  createdAt     DateTime @default(now())

  kbItem KnowledgeBaseItem @relation(fields: [kbItemId], references: [id], onDelete: Cascade)

  // Sütun sırası okuma sorgusunun ön ekidir (kbItemId IN … AND model = … AND recipe = … AND kind = …): ayrı dizin gerekmez.
  @@unique([kbItemId, model, recipe, kind, inputHash, ord])
}

model AutomationRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  triggerType    String // reservation_created | checkout_completed | message_received | complaint_detected
  conditionJson  String? // JSON-encoded condition
  actionJson     String // JSON-encoded action
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorUserId    String?
  action         String
  metadataJson   String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  // Migration 77 (gece-4 S8-05): öneri kararları (kurum + eylem + zaman) ve operatör sayfası (son kayıtlar) tam taramasın.
  @@index([organizationId, action, createdAt])
  @@index([createdAt])
}

// Distance-selling (Mesafeli Satış) consent EVIDENCE captured at CHECKOUT — the
// server-side counterpart to the client checkbox in paddle-plans.tsx. One row per
// acceptance (repeatable: a user may go through checkout more than once), written
// by /api/billing/consent right before Paddle's overlay opens. Mirrors AuditLog's
// org+actor shape; cascades away with the org on erasure (like Invoice/Subscription).
model CheckoutConsent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String? // who accepted (session user); SetNull if that user is later removed
  planCode       String // plan being purchased at acceptance time
  priceId        String // the exact Paddle price id shown
  legalVersion   String // LEGAL_VERSION at acceptance — which text was accepted
  // Tamper-evident companion to legalVersion (see lib/legal-text-hash.ts).
  // Nullable — rows written before this field existed (the live Paddle test
  // included) predate it.
  legalTextHash  String?
  ip             String? // server-derived (rightmost XFF), spoof-resistant
  userAgent      String? // request UA, length-capped
  // Takip numarası (migration 63, kurucu kararı 10-10): onayı yazan isteğin numarası — ödeme webhook'u zinciri BURADAN sürdürür
  // (Paddle'ın taşıdığı istemci verisinden değil). Eski satırlarda null.
  correlationId  String?
  createdAt      DateTime @default(now()) // = checkoutLegalAcceptedAt

  intents      CheckoutIntent[]
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([correlationId])
}

// TAKİP NUMARASI OLAY GÜNLÜĞÜ (migration 63, kurucu kararı 10-10 §5 — "güvenlik olarak çok gelişmiş olmalıyız"). YALNIZ-EKLE: veritabanı
// tetikleyicisi UPDATE'i reddeder; silme yalnız saklama süpürgesi (90 gün) ve işletme silinmesi (kademeli). TEK yazıcı `lib/event-log.ts`
// `logEvent`: olay adı kapalı küme, veri yalnız izinli anahtar + kimlik / kod / sayı biçimi (serbest metin / kişisel veri sığmaz). Okuma
// yalnız operatör (`api/admin/events`). İşletmesiz satır = sistem olayı.
model OperationalEvent {
  id             String   @id @default(cuid())
  correlationId  String
  organizationId String?
  event          String
  level          String
  dataJson       String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([correlationId])
  @@index([organizationId, createdAt])
  @@index([createdAt])
}

model MessageTemplate {
  id             String   @id @default(cuid())
  organizationId String
  propertyId     String? // null = org-wide
  category       String
  title          String
  body           String
  language       String   @default("tr")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Billing (Faz 2). ADDITIVE & DORMANT. These tables hold subscription/billing
// state but NOTHING is paywalled until billing is *explicitly* enforced
// (env BILLING_ENFORCED=true) AND existing orgs are backfilled as active.
// Default behaviour (see lib/billing): an org with no Subscription row is
// treated as grandfathered → active → unlimited, so live customers are never
// blocked. New rows are only created by the (future) checkout flow.
// ---------------------------------------------------------------------------

// Catalog of available plans. Limits follow the roadmap (1–2 / 3–7 / 8+).
model Plan {
  id            String   @id @default(cuid())
  code          String   @unique // free | pro | business (mirrors Organization.plan)
  name          String
  propertyLimit Int? // max properties; null = unlimited
  priceMinor    Int      @default(0) // price in smallest unit (kuruş for TRY); 0 = free
  currency      String   @default("TRY")
  interval      String   @default("month") // month | year
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// One subscription per organization (the billing source of truth).
model Subscription {
  id                String    @id @default(cuid())
  organizationId    String    @unique
  planCode          String    @default("free")
  status            String    @default("active") // active | trialing | past_due | canceled | grandfathered
  provider          String    @default("iyzico") // iyzico | paytr | paddle | trial | manual
  providerRef       String? // provider's subscription reference
  trialEndsAt       DateTime? // reverse-trial: when the free 14-day Pro trial ends
  // Deneme erken bittiyse sebebi (migration 61; kapalı küme): "identity_reused" = aynı ilan / iCal daha önce başka bir hesapta kullanıldı.
  trialEndReason    String?
  trialEndingSentAt DateTime? // "denemen bitiyor" reminder email sent at (idempotency)
  trialEndedSentAt  DateTime? // "deneme bitti" email sent at (idempotency)
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean   @default(false)
  // Stable anchor for the past_due dunning grace: set once on the first
  // transition INTO past_due, cleared on any non-past_due status. Grace counts
  // from here instead of the auto-bumping updatedAt (which every dunning webhook
  // pushed forward, so the window never elapsed → unpaid orgs kept access).
  pastDueSince      DateTime?
  // occurred_at of the newest Paddle subscription event we've applied. A later
  // event whose occurred_at is not newer is ignored, so a late/stale event can't
  // overwrite a fresher active/canceled state and flip access the wrong way.
  lastEventAt       DateTime?
  // Paddle customer id (ctm_...), stored by the webhook from events whose org was
  // resolved AUTHORITATIVELY (consent/providerRef — never client custom_data).
  // KVKK erasure uses THIS to attribute Paddle-generated customer.* events (they
  // carry no custom_data), so it can never learn another tenant's customer id.
  customerId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]

  // One provider subscription can bind to exactly ONE org (prod pre-verified
  // duplicate-free). NULLs are distinct: trial/manual rows (providerRef null)
  // are unaffected. Mirrors Invoice's [provider, providerRef] key.
  @@unique([provider, providerRef])
  @@index([status])
}

model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  subscriptionId String?
  amountMinor    Int
  currency       String    @default("TRY")
  status         String    @default("pending") // pending | paid | failed | refunded
  provider       String    @default("iyzico")
  providerRef    String?
  eArchiveStatus String    @default("none") // none | requested | issued | error
  metadataJson   String?
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  // One Invoice per provider transaction — DB-level idempotency the webhook's
  // findFirst-then-create couldn't guarantee under concurrent delivery (D1).
  // Postgres treats NULL providerRef as distinct → manual/legacy rows unaffected.
  // The migration pre-dedups (keeps the oldest per pair) before adding this, so
  // a populated table can never fail boot.
  @@unique([provider, providerRef])
  @@index([organizationId])
  @@index([status])
}

// Raw provider webhook events, stored idempotently (process each once).
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String    @default("iyzico")
  eventType       String?
  providerEventId String?   @unique // idempotency key
  payloadJson     String
  status          String    @default("received") // received | processed | error
  error           String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([provider, status])
}

// Append-only decision history for the AI risk pipeline (Codex #32). One row =
// one FINAL, DETERMINISTIC code decision (never raw model output): the auto-
// reply gate verdict or the keyword-alert escalation. PII-FREE BY DESIGN: no
// guest text, names, contacts or prompts — only closed-set enums + opaque ids.
// Reports aggregate the last 30 days from THIS history instead of the mutable
// Conversation snapshot (which lost every prior decision). No backfill: history
// starts at feature activation, and the report says so.
model RiskEvent {
  id                String    @id @default(cuid())
  organizationId    String
  // Plain metadata ids (NO FK — ChatUsage precedent): history survives
  // property/conversation cleanup; KVKK deletion is guaranteed by the
  // organization CASCADE below. Opaque cuids, never PII.
  propertyId        String?
  conversationId    String?
  surface           String // auto_reply | alerts (QR may join later)
  // The inbound Message id that forced this decision — with organizationId +
  // finalDecision it forms the TENANT-SCOPED retry-idempotency key: a retried
  // pass can't double-log, a LEGITIMATE later transition (held -> sent) still
  // records, and two tenants sharing a trigger string can never mask each other.
  triggerId         String
  finalDecision     String // auto_sent | human_review | no_reply (kapanış: hiçbir mesaj gönderilmedi, cevap gerekmedi)
  riskLevel         String? // none|low|medium|high (code-clamped); NULL on the keyword path (no model verdict — never fabricate one)
  riskType          String? // closed set (clamped in code) or null
  reason            String? // closed-set code (escalated_to_human, low_confidence_or_risky, keyword_escalated[_ack], gate_passed) — NEVER guest text
  confidence        Float? // model confidence at decision time (0-1) — feeds threshold tuning
  // A2 — TEMELLENDİRME İZLENEBİLİRLİĞİ (migration 54). Hepsi nullable ve
  // 🚨 NULL = "ÖLÇÜLMEDİ", 0 DEĞİL: eski satırlar ve ölçmeyen yollar sıfır
  // gibi görünüp "hiç kalem yoktu" diye okunamaz.
  kbRetrieved       Int? // koda göre isteme GERÇEKTEN giren kalem sayısı
  kbDropped         Int? // adet tavanı yüzünden düşen (ayrı kova — bilgi yokluğu DEĞİL)
  kbPendingApproval Int? // aktif ama onay kapısından geçmeyen (bilgi VAR, onaylanmamış)
  // 🚨 SÜRÜM KİMLİĞİ DEĞİL, TAZELİK İŞARETİ (kurucu 09-08): iki bambaşka kalem
  // kümesi aynı max'ı verebilir. "Hangi bilgiye dayandı" sorusunu kbEvidenceJson
  // yanıtlar.
  kbNewestUpdatedAt DateTime? // isteme giren kalemlerin en yeni updatedAt'i
  // Yetkili İÇ DENETİM kanıtı: [{type:"kb_item", id, v:<updatedAt>}] + doğrulanmış
  // kaynak etiketleri. `PropertyMemory.evidenceJson` deyiminin aynısı (yalnız
  // kimlik + sürüm, İÇERİK YOK). Misafire ASLA açılmaz.
  kbEvidenceJson    String?
  srcDeclared       Int? // modelin BEYAN ettiği kaynak sayısı (temizlenmiş)
  srcVerified       Int? // gerçek girdiyle DOĞRULANANLAR; fark = uydurma atıf
  occurredAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, surface, triggerId, finalDecision])
  @@index([organizationId, occurredAt])
}

// GLM/Akash GÖLGE katmanı — Aşama-1 (kullanıcı planı 07-16). İkinci modelin aynı
// inbound mesaj için BAĞIMSIZ güvenlik hükmü, kod kapısının NİHAİ kararının yanına
// kaydedilir. YETKİSİ SIFIR: fire-and-forget, gönderimi asla bloklamaz/geciktirmez/
// onaylamaz. Amaç: insan değerlendirmesiyle risk-kaçırma + yanlış-alarm oranını
// ölçmek; ancak Aşama-3'te (AYRI tur) veto-only yetki konuşulur. PII-FREE at rest:
// kapalı-set kodlar + opak id'ler; mesaj gövdesi ASLA bu tabloya yazılmaz.
model ShadowVerdict {
  id             String   @id @default(cuid())
  organizationId String
  conversationId String? // FK'sız opak id (RiskEvent emsali) — KVKK silme org CASCADE ile
  triggerId      String // gölgelenen inbound Message id (RiskEvent.triggerId ile aynı)
  gateDecision   String // kod kapısının NİHAİ kararı: auto_sent | human_review
  gateRiskLevel  String? // kapı anındaki model seviyesi (clamped) — kıyas bağlamı
  gateRiskType   String?
  verdict        String? // GLM: allow | hold | escalate; NULL = çağrı/parse başarısız
  riskType       String? // GLM'in risk sınıfı (RiskEvent ile AYNI kapalı set) veya null
  confidence     Float? // 0-1 aralığı dışı → NULL (asla uydurma değer)
  agrees         Boolean? // kolaylık: (verdict==allow) == (gateDecision==auto_sent); NULL=başarısız
  model          String // hangi gölge model koştu (env değişirse ayrışsın)
  latencyMs      Int?
  error          String? // redakte, kısa arıza nedeni (yalnız başarısız çağrıda)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, triggerId]) // mesaj başına TEK gölge hükmü (retry dedupe)
  @@index([createdAt])
}

// Durable Outbox (#8): a persistent, claim-safe queue for messages we send OUT to
// the guest's channel (Hospitable → Airbnb / Booking / ...). The send INTENT is
// written durably in the SAME transaction as the local Message, so a crash / timeout
// / replica-race can neither lose it nor double-send it. State machine + transitions
// live in src/lib/outbox/state.ts (closed set). DORMANT until DURABLE_OUTBOX_ENABLED
// is on — when off, nothing enqueues and no worker runs, so the live send path is
// exactly today's claim-then-send.
//
// FK policy (mirrors RiskEvent): organizationId is the ONLY foreign key (onDelete
// Cascade → KVKK / account erasure purges the tenant's outbox). conversationId /
// messageId / reservationId are OPAQUE ids (no FK): the row carries its own send
// TARGET snapshot (channel + externalReservationId + body), so a later conversation /
// message delete can never orphan the worker into an unsendable state. Payload holds
// ONLY what the send needs — never a token, auth header, PIN, pepper or credential.
model MessageOutbox {
  id                    String    @id @default(cuid())
  organizationId        String
  // NULLABLE (migration 30): a PROACTIVE lifecycle send (welcome/checkin/checkout) has no
  // conversation and no local Message — it is a pure send-intent keyed to a reservation.
  conversationId        String?
  messageId             String? // the local Message this send corresponds to (null for proactive lifecycle)
  reservationId         String?
  // Closed-set discriminator (migration 30): manual | ai | holding_ack | welcome | checkin | checkout.
  // NULL = a legacy reply row (rolling-deploy / pre-30) → treated as a normal reply on delivery.
  // The worker DERIVES the delivery side-effect from this (reply → mark answered; lifecycle →
  // stamp the reservation's *SentAt; holding_ack → keep the thread in "problem"). No separate
  // denormalized effect column — the mapping is stable and lives in code (deriveDeliveryEffect).
  messageType           String?
  // Send target snapshot — the worker delivers WITHOUT re-reading the conversation.
  channel               String // manual | airbnb | booking | ...
  externalReservationId String? // Hospitable reservation UUID (the delivery destination)
  // V0.3 (migration 49): the ChannelConnection this send was enqueued under (provenance +
  // future per-connection routing). NULLABLE, NO FK on purpose: legacy rows (pre-49) carry
  // null and keep delivering via the org's active connection; a connection row is never
  // deleted, so no cascade/SetNull semantics are wanted here.
  connectionId          String?
  body                  String // the exact text to deliver (minimum needed to send)
  // Tenant-scoped idempotency: the SAME logical message never enqueues or sends twice.
  idempotencyKey        String
  // State machine (closed set — see src/lib/outbox/state.ts).
  status                String    @default("pending")
  attemptCount          Int       @default(0)
  availableAt           DateTime  @default(now()) // not eligible before this (backoff gate)
  claimedAt             DateTime?
  claimExpiresAt        DateTime?
  claimedBy             String? // worker fencing token (only the holder may complete/release)
  providerMessageId     String? // provider's id — written ONLY after a confirmed / reconciled send
  lastErrorKind         String? // closed: definitive_failure | ambiguous (never a raw provider body)
  lastErrorCode         String? // sanitized short code (e.g. "HTTP 500", "timeout") — no secrets
  sentAt                DateTime?
  reconciledAt          DateTime?
  // Migration 80 (kurucu T4, 10-21): yaşam döngüsü satırı hangi `AutoMessageTemplate.revision` ile kuruldu. İşçi gönderimden ÖNCE güncel
  // sürümle kıyaslar; farklıysa (ya da NULL — geçiş öncesi satır) gövdeyi AYNI satırda güncel metinle yeniden kurar, metin boş / doldurulamaz
  // ise iptal eder. Anahtar değişmez (rezervasyon başına tek satır — çift gönderim yok). Yanıt satırlarında NULL.
  templateRevision      Int?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // One outbox row per logical message per tenant (double-enqueue / replay → dedupe-hit).
  @@unique([organizationId, idempotencyKey])
  // Worker due-query: claimable rows ordered by (status, availableAt).
  @@index([status, availableAt])
  @@index([organizationId, status])
  // Migration 69 (kurucu I3, 10-17 "migration yapalım"): konuşma başına okuma — teslim edilmemiş taslak süzgeçleri + işçinin konuşma başına
  // FIFO alt sorgusu tam tablo taraması yerine dizinden. YALNIZ maliyet; davranış dizinden bağımsız (O1 Seçenek A).
  @@index([conversationId, status])
  // Migration 79 (gece-4 S3-07 / S3-09; sert tasarım ajanı ölçtü — 2M satır, 20 bin birikim): YALNIZ maliyet, davranış dizinden bağımsız.
  //  · talep sorgusunun rezervasyon başına "son 60 sn denemesi" alt sorgusu her aday için işletmenin bütün satırlarını tarıyordu (7,65 sn);
  //    claimedAt dizini son 60 saniyenin taleplerini doğrudan bulur (üç sütunlu ayrı dizin bu dizin varken planlayıcıca seçilmedi — eklenmedi);
  //  · kuyruk sağlığı "son 15 dk ilerleme" okuması (claimedAt OR sentAt) tam tablo tarıyordu (~1 sn → 0,03 ms, iki düz dizin BitmapOr);
  //  · teslim etkisi onarıcısı son 48 saatin gönderilmişlerini sentAt'ten bulur (gönderilmiş satırlar silinmez — tablo büyür).
  @@index([sentAt])
  @@index([claimedAt])
}

// ---------------------------------------------------------------------------
// AutomatedMessageSend (K7, migration 58, kurucu onayı 09-30) — GÖNDERDİĞİMİZ otomatik şablon mesajının izi
// (karşılama / giriş / çıkış). Senkron aynı mesajı sağlayıcıdan geri getirdiğinde "ev sahibi yazdı" SAYILMAZ:
// `Message.authorType = "automation"` yazılır → açık öğeyi kapatmaz, konuşmayı "cevaplandı" yapmaz, cevapsız misafir
// penceresini sıfırlamaz, ardından gelen "Teşekkürler" konuşmayı gizlemez (`message-author.ts`).
//
// METİN SAKLANMAZ — yalnız normalize edilmiş gövdenin SHA-256 özeti (`automated-sends.ts`). Eşleşme: önce sağlayıcı
// mesaj kimliği, sonra aynı thread + aynı özet + sağlayıcı anı [gönderim − 2 dk, gönderim + 24 sa]; bire bir
// (`matchedExternalId`). Satır gönderimden ÖNCE yazılır (süreç POST ile kayıt arasında düşse de mesaj tanınır) ve
// sonuçla kapanır (sent · unverified = belirsiz, teslim edilmiş olabilir · failed = teslim edilmedi, eşleşmez). 14 gün
// sonra silinir. FK politikası MessageOutbox ile aynı: YALNIZ organizationId (hesap silme); rezervasyon kimliği opak.
// ---------------------------------------------------------------------------
// AutoMessageTemplate (kurucu T4, migration 80, 10-21) — DAİRE BAŞINA OTOMATİK MESAJ METNİ (karşılama · giriş · çıkış).
// Önceden metin bilgi tabanından gelirdi (kategorinin EN SON güncellenen onaylı kalemi): bilgi tabanına kalem eklemek / düzenlemek / öğrenilen
// taslağı onaylamak misafire giden otomatik mesajı SESSİZCE değiştiriyordu. Artık metin yalnız mülk sayfasındaki "Otomatik mesajlar"
// bölümünden, önizlemeyle ve açık kayıtla değişir. Geçiş bugün gerçekten seçilecek metni AYNEN kopyalar (mesaj göndermez, gönderim damgalarına
// dokunmaz). Bilgi tabanı kalemleri BİLGİ olarak kalır (yapay zekâ okur). `revision` her kayıtta artar — kuyruktaki eski metin gönderimden önce
// yeniden kurulur (`MessageOutbox.templateRevision`). Boş metin = o mesaj gönderilmez (satır silinmez; iz kalır).
// ---------------------------------------------------------------------------
model AutoMessageTemplate {
  id                   String    @id @default(cuid())
  organizationId       String
  propertyId           String
  kind                 String // welcome | checkin | checkout (kapalı küme — `auto-messages/render.ts`)
  body                 String    @default("")
  revision             Int       @default(1)
  /// Geçişte kopyalanan bilgi tabanı kalemi (yalnız iz; FK YOK — kalem silinse de metin kalır).
  migratedFromKbItemId String?
  /// Geçişte aynı anda güncellenmiş FARKLI içerikli iki kalem vardı (bugünkü seçim keyfiydi) — ev sahibi kontrol edip kaydedene kadar kartta uyarı.
  needsReview          Boolean   @default(false)
  /// Son atlama sebebi (unfilled · apartment_unresolved) — kart ev sahibine gösterir; kayıtta temizlenir.
  lastSkipReason       String?
  lastSkippedAt        DateTime?
  updatedByUserId      String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, kind])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// KbCopyOperation (Codex 10-21, migration 81) — BİLGİ TABANI KOPYALAMA İŞLEM KAYDI. Kopyalama tekrar güvenliği eskiden yalnız kalemlerdeki
// değiştirilebilir `clientRequestId` alanına dayanıyordu: araya başka bir kopyalama girip o alanı değiştirince eski işlem UNUTULUYOR, eski
// kimlikle yeniden deneme (kaynak arada değişmiş olsa da) daireleri yeniden güncelliyordu. Artık işlem başına KALICI satır: ilk denemedeki
// kaynak içerik izi saklanır → aynı kimlik + farklı iz = 409 (hiçbir şey yazılmaz). Aynı izle tekrar bugünkü gibi yalnız eksikleri yazar.
// Kaynak kalem silinse de satır kalır (FK yok; yalnız iz). 30 gün sonra silinir. Misafir verisi yok.
// ---------------------------------------------------------------------------
model KbCopyOperation {
  id             String   @id @default(cuid())
  organizationId String
  sourceItemId   String
  requestId      String
  /// İlk denemede kaynağın içerik izi (`kbContentFingerprint`).
  sourceHash     String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceItemId, requestId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// CheckoutIntent (Codex 10-21 P1, migration 82; tasarım `docs/TASARIM-2026-10-16-faz2-migration-paketleri.md` §3) — ÖDEME NİYETİ.
// İki sekme aynı anda onay verince iki AYRI ödeme ekranı açılıyor, iki tahsilat mümkün oluyordu. Anahtar `PADDLE_CHECKOUT_INTENT_ENABLED`
// açıkken ödeme ekranı sunucunun açtığı TEK Paddle işlemiyle açılır: işletme başına en çok bir açık niyet (`openKey` = işletme, kapanınca
// NULL — kısmi dizin yerine), iki sekme aynı işlemi görür. Delil kaydı `CheckoutConsent`te kalır (değişmez). Kapalıyken tablo boş kalır.
// Takma adlı kimlikler (işletme, onay, Paddle işlem kimliği); misafir verisi yok. Kapanan niyet 90 gün sonra silinir.
// ---------------------------------------------------------------------------
model CheckoutIntent {
  id             String    @id @default(cuid())
  organizationId String
  /// İşlemi açan onay (Paddle `custom_data.consentId` bu olur → webhook bugünkü gibi onaydan bağlar).
  consentId      String
  planCode       String
  priceId        String
  /// Paddle işlem kimliği (txn_…); NULL = Paddle çağrısı sürüyor.
  providerRef    String?   @unique
  /// opening · open · completed · canceled · expired · failed (kapalı küme, `lib/billing/checkout-intent.ts`).
  status         String
  /// Açık niyet tekil anahtarı: opening / open iken = organizationId, kapanınca NULL.
  openKey        String?   @unique
  /// Ödeme ekranının geçerliliği (3 sa; webhook onay tazeliği 24 sa sınırının içinde).
  expiresAt      DateTime
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  consent      CheckoutConsent @relation(fields: [consentId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([status, expiresAt])
}

model AutomatedMessageSend {
  id                    String    @id @default(cuid())
  organizationId        String
  propertyId            String // eşleşme kapsamı: dış rezervasyon kimliği mülk başına tekildir
  reservationId         String? // opak (FK yok)
  externalReservationId String // sağlayıcı thread'i (Reservation.sourceReference = Conversation.externalReservationId)
  kind                  String // kapalı küme: welcome | checkin | checkout
  bodyHash              String // normalize edilmiş gövdenin SHA-256'sı (metin yok)
  state                 String // pending | sent | unverified | failed
  providerMessageId     String?
  sentAt                DateTime // UYGULAMA saati (tek saat kuralı; şema varsayılanına bırakılmaz)
  matchedExternalId     String? // senkronda eşleştiği sağlayıcı mesaj kimliği (bire bir)
  matchedAt             DateTime?
  createdAt             DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, propertyId, externalReservationId])
  @@index([sentAt])
}

// ---------------------------------------------------------------------------
// ChannelConnection (V0.3, migration 49) — the provider CONNECTION as its own record.
//
// Until now the only provider credential lived as five `hospitable*` columns on
// Organization: no lifecycle (revoked ≠ disconnected), no generation (the refresh
// race was fenced on the ciphertext blob), no room for a second provider or account.
// V0.3 is EXPAND: this table is DUAL-WRITTEN next to the org columns (connect /
// disconnect / refresh / revoke all write both in one transaction), an idempotent
// backfill copies existing connections, and READS switch over behind
// CHANNEL_CONNECTION_READ=1 (default off). The org columns are contracted only
// in V0.7 after the read-switch has run clean in production.
//
// Invariants:
//   • one row per (organizationId, provider) — the row is REUSED across
//     disconnect/reconnect; `generation` increments on EVERY credential write
//     (connect, reconnect, refresh, disconnect, revoke) and is the CAS anchor for
//     the OAuth refresh race (a stale refresh matches 0 rows and is discarded);
//   • `status`: active (usable) | disconnected (host removed it) | revoked
//     (provider rejected the credential: refresh invalid_grant, 401/403 on send);
//     tokens are cleared on both non-active states; `label` is kept for the UI;
//   • credentials are stored ENCRYPTED with the same crypto-core key as the org
//     columns (the backfill copies ciphertext verbatim — no re-encryption);
//   • tenant boundary: every read is by organizationId; a MessageOutbox row whose
//     connectionId belongs to another org is canceled by the worker, never sent.
// ---------------------------------------------------------------------------
model ChannelConnection {
  id                String    @id @default(cuid())
  organizationId    String
  provider          String // closed set in code (channels/outbound.ts OutboundProvider): "hospitable"
  status            String    @default("active") // active | disconnected | revoked (closed set, app-enforced)
  label             String? // human label for the connected account (e.g. "8 mülk")
  accessTokenEnc    String? // encrypted access token / PAT (null when not active)
  refreshTokenEnc   String? // encrypted OAuth refresh token (null for PAT)
  tokenExpiresAt    DateTime? // OAuth access-token expiry; null = does not expire (PAT)
  generation        Int       @default(1) // bumps on every credential write — refresh CAS anchor
  connectedAt       DateTime?
  disconnectedAt    DateTime?
  revokedAt         DateTime?
  revokedReason     String? // closed: refresh_invalid_grant | send_401 | send_403
  lastRefreshAt     DateTime?
  // Migration 60 (değişmez 9): sağlayıcıdan bağımsız bağlantı SAĞLIĞI — son başarılı / başarısız okuma ve kapalı küme hata türü
  // (`IngestErrorKind`). Panel "iyi / sorunlu / okunamıyor" türetir; NULL = gözlenmedi.
  lastReadOkAt      DateTime?
  lastReadErrorAt   DateTime?
  lastReadErrorKind String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings     ChannelListing[]

  // One connection per provider per org (V0.3). A multi-account-per-provider model would
  // change this key on a POPULATED table — a decision for a later migration, not a default.
  @@unique([organizationId, provider])
  @@index([status])
}

// ---------------------------------------------------------------------------
// INGEST EVENT — versioned domain event / transactional outbox (V0.6, migration 51).
// Write service canonical satırı yazdığı TX'te bir event de yazar: satır varsa event
// vardır, tersi de. PII'SİZ tasarım: misafir metni/adı ve sağlayıcı kimliği YOK — yalnız
// kiracı, sağlayıcı, bağlantı, varlık türü + BİZİM id'miz, tür, şema sürümü, zaman.
// Tüketen kod (V1 Property Memory, Exception Feed) satırı id ile okur. KVKK süpürgeleri
// bu tabloyu bilmez (kapsam dışı; kanarya yorumu scrub-scope-parity'de). Org silinince
// cascade. entityId'ye FK YOK: satır silinse de "olay gerçekleşti" kaydı kalır (opak id).
// dispatchedAt: tüketici (`modules/intelligence/consumer.ts`) olayı işleyince damgalar.
// ---------------------------------------------------------------------------
model IngestEvent {
  id                String    @id @default(cuid())
  organizationId    String
  provider          String // closed set in code (channels/outbound.ts OutboundProvider)
  connectionId      String? // aktif bağlantı (null = env fallback / legacy)
  entityType        String // reservation | conversation | message (closed set, app-enforced)
  entityId          String // bizim satır id'miz (FK yok)
  kind              String // reservation.created|updated|cancelled · conversation.created|updated · message.imported
  schemaVersion     Int       @default(1)
  // V1: `reservation.updated` için DEĞİŞEN ALAN ADLARI (JSON string[]; PII'siz — değer yok).
  changedFieldsJson String?
  occurredAt        DateTime  @default(now())
  dispatchedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  // Tüketici her geçişte "işlenmemiş olaylar, en eskiden" okur (dispatchedAt NULL). Tablo hiç silinmez; bu dizin olmadan sorgu kurumun
  // BÜTÜN işlenmiş geçmişini gezip eler (S8-04, migration 78). Btree `IS NULL`u dizin koşulu olarak kullanır.
  @@index([organizationId, dispatchedAt, occurredAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// V1 — PROPERTY MEMORY + SIGNALS (intelligence bounded context; migration 52).
// Signal = mülk merkezli OPERASYONEL GÖZLEM (kurucu: source/category/sentiment/severity/
// confidence/reservation/occurredAt). RiskEvent ile karıştırma: o AI kapısının KARAR
// günlüğüdür. PII'SİZ: misafir metni/adı yok; yalnız kategori, ölçüler, opak id'ler.
// occurredAt = GERÇEK olay zamanı (mesajın createdAt'i / event zamanı) — uydurma yok.
// dedupeKey: aynı olay ikinci kez işlenince mükerrer sinyal ÜRETİLMEZ (unique).
// KVKK: misafir mesajından türeyen sinyal DATA_RETENTION_MONTHS sonrası purge edilir;
// rezervasyon/konuşma silinirse SetNull (mülk hafızası kalır). Kanarya dışı (bilinçli).
// ---------------------------------------------------------------------------
model Signal {
  id               String    @id @default(cuid())
  organizationId   String
  propertyId       String
  reservationId    String?
  conversationId   String?
  source           String // guest_message | reservation (closed set, app-enforced)
  kind             String // message.intent | reservation.cancelled | reservation.dates_changed
  category         String // intent kümesi | cancellation | date_change
  sentiment        String? // negative | neutral | positive
  severity         Float // 0..1
  confidence       Float // 0..1 (kelime ağı: sabit, mütevazı)
  occurredAt       DateTime
  sourceEventId    String? // IngestEvent id (opak)
  sourceEntityType String // message | reservation
  sourceEntityId   String // opak id (FK yok)
  dedupeKey        String    @unique
  resolvedAt       DateTime?
  createdAt        DateTime  @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation?  @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt])
  // Migration 77 (gece-4 S8-01): konuşma / rezervasyon silinince FK eylemi (SET NULL) tablo taramasın.
  @@index([conversationId])
  @@index([reservationId])
  @@index([propertyId, category, occurredAt])
}

// KONUŞMA ÖĞESİ (migration 56, 09-26 — kurucu kararları; tasarım `docs/TASARIM-2026-09-26-konusma-ogeleri.md`).
// Misafirin bir mesajındaki TEK istek/soru. Hassas istek sessizce ev sahibinde açık kalır, güvenli istek cevaplanır;
// eski risk yeni mesajla KAYBOLMAZ ama konuşmayı da BLOKE ETMEZ. METİN YOK (PII yok): yalnız kimlikler + kapalı-küme
// kodlar (uygulama zorlar). `messageId` düz kimlik (FK yok, `RiskEvent` emsali: KVKK süpürgesi mesajı anonimleştirir).
/// Misafirin bir mesajındaki TEK istek/soru (09-26, kurucu kararları; `src/lib/conversation-items/`). METİN/PII YOK:
/// yalnız kimlikler + kapalı küme kodlar. Bir mesajda her tür (kind) BİR kez: kelime ağı (senkron uyarı geçişi) ve anlama
/// katmanı (cevap geçişi) aynı öğeyi BİRLEŞTİRİR — hassaslık yalnız yükselir.
model ConversationItem {
  id                  String    @id @default(cuid())
  organizationId      String
  conversationId      String
  messageId           String // kaynak misafir mesajı (düz kimlik, FK yok — RiskEvent emsali)
  requestIndex        Int       @default(0) // mesaj içindeki ilk görülme sırası (yalnız görüntü sırası)
  kind                String // anlama katmanı niyeti (kapalı küme; "other" dahil)
  sensitivity         String    @default("none") // none | sensitive | emergency — yalnız YÜKSELİR
  riskType            String? // hassaslığın ilk gerekçesi (kapalı küme etiket)
  sources             String // virgüllü kapalı küme: lexical, understanding, reply_model
  status              String    @default("open") // open | pending_host | answered | withdrawn | superseded | done
  notifiedAt          DateTime? // ev sahibine acil e-posta (atomik claim; gönderilemezse geri alınır)
  answeredByMessageId String?
  resolvedAt          DateTime?
  // Migration 84 (kurucu 10-23 D): aynı mesajda aynı türden kaçıncı istek (0 = ilk; `AI_ITEM_ORDINAL_ENABLED` kapalıyken hep 0).
  ordinal             Int       @default(0)
  // Kısa konu etiketi (kurucu 10-23 C): anlama sorgusunun sözcüklerinden KODLA kurulur (≤3 sözcük / 40 karakter, ad / rakam / sır
  // sözcüğü yok); misafir kaynaklı veri — silme talebinde boşaltılır, süre bazlı temizlikte satırla birlikte silinir. Modele GİTMEZ.
  topic               String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId, kind, ordinal])
  @@index([organizationId, status])
  @@index([conversationId, status])
}

// HOST KARAR MOTORU (Faz 1, migration 59; tasarım `docs/TASARIM-2026-10-02-host-karar-motoru.md`). Misafirin ev sahibi KARARI
// gerektiren konaklama isteği (erken giriş / geç çıkış / uzatma / tarih değişikliği): "karar bekliyor" kartı, tek bildirim, ev
// sahibi onaylayınca ya da reddedince sonuçlanır. Metin TAŞIMAZ (misafir metni / adı yok): kimlik + kapalı küme kodlar + saat / gün.
// Kimlik (konuşma, mesaj, tür) — konuşma öğesiyle aynı tekillik; öğe bağlantısı düz kimlik (FK yok, öğe silinmez).
// "Ev sahibi yazdı" / "gün geçti" / "rezervasyon iptal" SAKLANMAZ, okumada türetilir (`decisions/core.ts`).
model DecisionRequest {
  id              String    @id @default(cuid())
  organizationId  String
  conversationId  String
  messageId       String // isteği taşıyan misafir mesajı (düz kimlik — ConversationItem emsali)
  itemId          String? // aynı isteğin konuşma öğesi (varsa; düz kimlik)
  reservationId   String? // opak (FK yok)
  kind            String // kapalı küme: early_checkin | late_checkout | extend_stay | date_change
  requestedTime   String? // "HH:MM" — model okumalarının anlaştığı ya da misafirin yazdığı TEK açık saat; yoksa null
  dayKey          String? // hedef takvim günü (YYYY-MM-DD, mülk dilimi): erken giriş = varış, geç çıkış / uzatma = çıkış
  lang            String // misafirin dili (karar metninin dili; kapalı küme, tanınmayan → en)
  status          String    @default("pending") // pending | sending | approved | declined | send_unverified | superseded | dismissed | resolved_by_policy
  version         Int       @default(0) // CAS: her durum geçişi artırır (çift tıklama / eşzamanlı karar)
  decidedTime     String? // onaylanan saat ("HH:MM"; retde null)
  decidedById     String? // kararı veren kullanıcı (opak; kullanıcı silinse de kayıt kalır)
  decidedAt       DateTime?
  resultMessageId String? // misafire giden karar mesajı
  notifiedAt      DateTime? // "Karar bekliyor" e-postası (atomik claim; gönderilemezse geri alınır)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, messageId, kind])
  @@index([organizationId, status])
  @@index([conversationId, status])
}

// PropertyMemory = "yaşayan hafıza" kalemi. Değişmez 13: evidence/source · confidence ·
// observedAt · effectiveAt · lastConfirmedAt · expiresAt · contradiction · human override.
// source=kb_item: host'un KB metni (başlangıç hafızası, kaynağı açık; observedAt = kb.updatedAt).
// source=signal_pattern: sinyallerden türeyen örüntü ("hot_water: 4 sinyal / 118 gün", recurring).
// LLM çıkarımı V1'de YOK. Misafir PII'si yok (KB metni host'undur).
model PropertyMemory {
  id                  String    @id @default(cuid())
  organizationId      String
  propertyId          String
  kind                String // fact | risk | pattern (closed set, app-enforced)
  category            String
  title               String
  body                String?
  source              String // kb_item | signal_pattern | human
  sourceRef           String // kb item id | pattern anahtarı — idempotent upsert
  evidenceJson        String // [{type, id}] — yalnız id'ler
  confidence          Float
  observedAt          DateTime
  effectiveAt         DateTime?
  lastConfirmedAt     DateTime?
  expiresAt           DateTime?
  contradictedById    String?
  humanOverrideAt     DateTime?
  humanOverrideUserId String?
  status              String    @default("active") // active | superseded | retired
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([propertyId, source, sourceRef])
  @@index([organizationId, propertyId, status])
}

// Durable deletion intents for PRIVATE object storage (S3/R2) — migration 32.
// A row = "this object key must eventually be deleted from the bucket". Written in
// the SAME transaction as (or immediately before) the DB delete that orphans the
// object, so a provider outage can never turn the DB operation into a silent
// object leak: the intent persists and is retried by the scheduled drain.
// NO relation to Organization ON PURPOSE (ChatUsage precedent — opaque tenant id):
// rows must SURVIVE the org-cascade so a KVKK account erasure can still remove the
// org's objects from the bucket AFTER the org row is gone. Keys carry no guest PII
// (org/task cuids + a random filename only).
model StorageDeletion {
  id             String    @id @default(cuid())
  objectKey      String    @unique // idempotency anchor: the same object never queues twice
  organizationId String // opaque tenant id (NOT an FK — see note above)
  status         String    @default("pending") // pending | deleted (closed set, app-enforced)
  attemptCount   Int       @default(0)
  availableAt    DateTime  @default(now()) // backoff gate — not eligible before this
  lastError      String? // sanitized short code (e.g. "HTTP 500") — never a provider body/secret
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Drain due-query: pending rows ordered by availableAt.
  @@index([status, availableAt])
  @@index([organizationId])
}

// KVKK explicit-erasure tombstones — migration 40 (design: docs/DATA-RETENTION-
// ERASURE-DRAFT.md §8c). One row = "data matching this hashed identifier, from
// on/before erasedAt, may NEVER re-enter via sync/import" — the durable guard
// that makes an explicit deletion request (Law 6698 art. 11 via art. 7; Deletion
// Regulation art. 8: erased data must stay 'tekrar kullanılamaz') survive a
// provider re-sync. Carries NO raw PII: identifiers are HMAC-SHA256 hashes
// (keyed from ENCRYPTION_KEY), captured AT REQUEST TIME before the scrub.
// Lawful basis for keeping the hash itself: art. 5/2-ç (fulfilling the erasure
// duty) — domestic precedent: commercial-email OPT-OUT records must themselves
// be retained (Ticari İletişim Yönetmeliği m.13). Kept while the org lives
// (the provider can re-send the same data at any time); org delete cascades.
model ErasureTombstone {
  id             String    @id @default(cuid())
  organizationId String
  keyType        String // source_reference | guest_external_id | guest_email | guest_phone (closed set, app-enforced)
  keyHash        String // versioned "v1:" + HMAC-SHA256("orgId|type:normalized-value") hex — never the raw value (org in the domain: same identifier in two tenants hashes differently)
  erasedAt       DateTime // cutoff: matching data at/before this instant never re-imports
  // Legal retention bound for the tombstone ITSELF (m41): null = kept while the
  // org lives (current default — the provider can re-send at any time). If the
  // lawyer sets a bounded period, rows get a date and the guard ignores them
  // once expired. [AVUKAT İMZASI] decides which; code supports both.
  expiresAt      DateTime?
  // Fingerprint of the HMAC key that produced keyHash (m42, Codex P1). The "v1:"
  // prefix marks the SCHEME, not the SECRET VALUE — so a rotated/mistyped secret
  // would silently produce non-matching hashes. loadErasureGuard fails CLOSED
  // when a live row's fingerprint ≠ the current key's (nullable = legacy/unknown,
  // also treated as a mismatch → block). Reveals nothing (derived from the key).
  keyFingerprint String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Same identifier erased twice → single row (createMany skipDuplicates).
  // NEW table → adding @@unique is safe (the populated-table rule doesn't apply).
  @@unique([organizationId, keyHash])
  @@index([organizationId])
}

// Durable outbox for IDENTITY e-mails (Tur-4, docs/EMAIL-OUTBOX-DESIGN.md):
// verify_email / pw_reset_code / pw_change_code. The row is the delivery
// authority (an in-process poller + the 2-min cron drain it); the secret and
// the recipient snapshot live ONLY in payloadEnc — AES-256-GCM bound via AAD
// to (id, userId, kind), NULLed on every terminal transition (sent / canceled /
// terminal failed / expiry). `version` is the per-(user,kind) generation
// counter: a new request supersedes older undelivered rows, and the currency
// gate (no higher version + User hash still live) makes a stale row's
// resurrection structurally impossible. NEW table → additive, populated-table
// rules don't apply. User cascade: account erasure removes queued rows too.
model EmailOutbox {
  id             String    @id // pre-generated UUID — participates in the AAD
  userId         String
  kind           String // verify_email | pw_reset_code | pw_change_code
  version        Int
  payloadEnc     String? // encrypted {secret, recipient}; NULL once undeliverable/delivered
  status         String    @default("pending") // pending | claimed | sending | sent | failed | canceled
  attemptCount   Int       @default(0)
  nextAttemptAt  DateTime  @default(now())
  claimedBy      String?
  claimExpiresAt DateTime?
  expiresAt      DateTime // the SECRET's own TTL — never send past this
  sentAt         DateTime?
  lastError      String? // scrubbed provider error (no recipient/secret ever)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, version])
  @@index([status, nextAttemptAt])
}

