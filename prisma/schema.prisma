// MIGRATION 60 (kurucu onayı 10-09: "tamamını hazırla"; tasarım `docs/TASARIM-2026-10-09-migration-paketi-60.md`).
// ---------------------------------------------------------------------------

/// Bağlantı KAPSAMLI ilan kimliği (değişmez 3): dış kimlik global / mülk-içi eşsiz sayılmaz; eşsizlik (bağlantı, dış kimlik).
/// `Property.hospitableId` (global unique) geçiş boyunca DURUR; okumalar `CHANNEL_LISTING_READ` arkasında, satırı olmayan mülkte
/// `hospitableId`e düşer. `connectionId` CASCADE bilinçli: bağlantı satırı kod içinde silinmez (kopma / iptal belirteci boşaltır),
/// tek silme yolu org silmesi; `RESTRICT` org silmesini kilitleyebilirdi.
model ChannelListing {
  id             String   @id @default(cuid())
  organizationId String
  connectionId   String
  externalId     String
  propertyId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   ChannelConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  property     Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([connectionId, externalId])
  @@index([propertyId])
  @@index([organizationId])
}

/// Yapay zekâ ÜRETİM İZİ (talimat 09-07 "Generation trace" + Kurucu AI Kalite Konsolu). Kurucu §D-1: taslak ve gönderilen METİN
/// saklanır → `Message` ile AYNI saklama süpürgesi (24 ay) ve misafir silmesinde maskelenir; konuşma silinince CASCADE. Eğitim /
/// ince ayar yoluna BAĞLANMAZ (mekanik pin). `propertyId` / `reservationId` / `triggerMessageId` opak (RiskEvent emsali).
model AiGeneration {
  id                     String   @id @default(cuid())
  organizationId         String
  /// ZORUNLU (Haiku incelemesi 10-09): saklama süpürgesi + misafir silmesi metni konuşmadan bulur; konuşmasız satırın metni hiçbir
  /// süpürgeye düşmezdi. Bütün yüzeyler (kanal, QR, karar kartı) bir Conversation'a bağlıdır.
  conversationId         String
  propertyId             String?
  reservationId          String?
  triggerMessageId       String?
  /// kapalı küme: channel_auto · channel_suggest · qr · decision_text
  surface                String
  model                  String
  promptVersion          String
  retrievalVersion       String?
  toolContractVersion    Int?
  /// kimlik + sürüm (RiskEvent.kbEvidenceJson biçimi), içerik YOK
  kbEvidenceJson         String?
  /// VerifiedToolResult[] (PII'siz)
  toolResultsJson        String?
  /// auto_sent · human_review · no_reply
  decision               String
  gateReason             String?
  latencyMs              Int?
  promptTokens           Int?
  completionTokens       Int?
  reasoningTokens        Int?
  costMicroUsd           Int?
  draftText              String?
  sentText               String?
  /// dahil mesaj kimlikleri, atlanan / bekleyen sayısı (PII yok)
  contextDiagnosticsJson String?
  createdAt              DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  labels       AiReviewLabel[]

  @@index([organizationId, createdAt])
  @@index([conversationId])
}

/// Kurucu kalite konsolu ETİKETİ — operasyon verisinden AYRI; müşteriye görünen hiçbir şeyi değiştirmez.
model AiReviewLabel {
  id             String   @id @default(cuid())
  generationId   String
  /// süper-admin (opak)
  reviewerUserId String?
  /// kapalı küme: correct · hallucinated_fact · missed_context · repeated_greeting · wrong_tone · temporal_error · stale_knowledge ·
  /// retrieval_failure · tool_should_have_been_used · unsafe_auto_send · escalation_failure
  label          String
  note           String?
  createdAt      DateTime @default(now())

  generation AiGeneration @relation(fields: [generationId], references: [id], onDelete: Cascade)

  @@index([generationId])
}

